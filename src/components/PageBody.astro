    }
    .about__summary {
      border-inline-start: 0;
      padding-inline-start: 0;
      margin-top: 1.7rem;
      border-top: 1px solid var(--mx-green-far);
      padding-top: 1.7rem;
    }
  }

  /* --- Competencies "04 / SKILL CONSTELLATION" (2026-08-08 redesign): six
     capability nodes wired by meaningful connections. Same ~90%-void panel as
     About holds the compact intro; the constellation nodes sit on the denser
     --surface-code console surface so their small tokens stay ≥4.5:1 over the
     live rain (P6). Green dominant; violet (--note-accent) only on the
     Purple Team node + its edges (owner accent call — existing token, P7).
     Interaction is pure CSS: native <details> for disclosure, :has() for the
     highlight/dim (generated in src/data/competencies.ts, injected is:global).
     Layout is deterministic (fractional cx/cy from the data), never random. --- */
  .comp {
    background: var(--crt-lines-matrix), var(--surface-panel);
    border: 1px solid var(--mx-green-far);
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
    /* Chips/titles/nodes are not prose — cancel the .section__body justify +
       hyphens for everything here (the compact intro prose re-enables its own). */
    text-align: left;
    -webkit-hyphens: none;
    hyphens: none;
  }
  /* Discipline line — the section's compact lead-in (the "6+ YEARS / OFFENSIVE
     SECURITY" banner above it was removed on the owner's call). */
  .comp__disciplines {
    margin: 0;
    text-align: center;
    color: var(--mx-green-mid);
    font-size: clamp(0.62rem, 1.5vw, 0.74rem);
    letter-spacing: 0.06em;
  }
  /* Full professional summary, kept as the accessible compact intro (real
     bilingual cv.json prose; re-enables prose justify/hyphenation). */
  .comp__lead {
    margin: 1.25rem auto 0;
    max-width: 46rem;
    color: var(--mx-green-hi);
    font-size: clamp(0.8rem, 1.5vw, 0.92rem);
    line-height: 1.7;
    text-align: justify;
    -webkit-hyphens: auto;
    hyphens: auto;
  }

  /* --- The competency map ("Ruta Activa", 2026-08-09; supersedes the
     absolute-positioned aspect-ratio constellation stage — SAME nodes, SAME
     content, SAME details/summary + :has() machinery, layout + active state
     only). Cards sit on a responsive grid with content-driven heights
     (desktop 3×2 per the COMPETENCY_GRID inline custom props, tablet 2-col
     auto-flow, mobile 1-col); the aria-hidden SVG beneath draws MEASURED
     border-to-border connectors (competencies-map.ts — ResizeObserver + one
     rAF). The SVG stays display:none until the module stamps data-cxn-ready,
     so no-JS ships a clean grid + the relations as text, never a misaligned
     decoration (P5). --- */
  .cxn {
    /* Interaction tuning knobs (read by the generated :has() rules). Base =
       the stacked mobile flow, where the dim/highlight is neutralized so
       every card reads fully (the SVG is hidden there; relations are text).
       The map tiers (≥40rem) set the real dims — moderate, never illegible
       (the brief's "atenuar sin volver ilegible"). */
    --cxn-dim-node: 1;
    --cxn-dim-edge: 1;
    --cxn-edge-w-hi: 2.25;
    position: relative;
    margin: 1.9rem 0 0;
  }
  /* Decorative connection layer (aria-hidden, never captures events). The
     module re-pins the viewBox to the map's pixel box each pass, so the
     endpoint dots stay perfect circles (no non-uniform scale). */
  .cxn__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }
  /* An edge GROUP: path + its two endpoint dots. Base = perceptible at low
     contrast (the brief: inactive lines stay visible); --edge-hi/--edge-glow
     are what the generated :has() rules switch to, per accent. stroke and
     stroke-width inherit from the group into the path. */
  .cxn__edge {
    --edge-c: color-mix(in srgb, var(--mx-green-dim) 88%, transparent);
    --edge-hi: var(--mx-green);
    --edge-glow: color-mix(in srgb, var(--mx-green) 55%, transparent);
    stroke: var(--edge-c);
    stroke-width: 1.25;
    opacity: 0.8;
  }
  .cxn__edge[data-accent='purple'] {
    --edge-c: var(--note-mid);
    --edge-hi: var(--note-accent);
    --edge-glow: color-mix(in srgb, var(--note-accent) 55%, transparent);
  }
  .cxn__edge-line {
    fill: none;
  }
  /* Origin/destination markers. Fill + radius ride custom props so the ONE
     generated per-node rule can relight/enlarge them (--edge-dot/--edge-dot-r
     inherit from the group). */
  .cxn__edge-dot {
    fill: var(--edge-dot, var(--edge-c));
    stroke: none;
    r: var(--edge-dot-r, 2.4px);
  }
  :global(html[data-motion='full']) .cxn__edge {
    transition:
      opacity 0.3s ease,
      stroke 0.3s ease,
      stroke-width 0.3s ease,
      filter 0.3s ease;
  }

  /* The node grid. Mobile-first single column; the map tiers add columns,
     generous gaps (connections route through them, never across text — the
     cards are opaque surfaces above the SVG) and the arch headroom. */
  .cxn__nodes {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
  }
  .cxn__item {
    min-width: 0;
  }
  @media (min-width: 40rem) {
    .cxn {
      --cxn-dim-node: 0.55;
      --cxn-dim-edge: 0.3;
    }
    .cxn[data-cxn-ready] .cxn__links {
      display: block;
    }
    .cxn__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.4rem;
      row-gap: 2.4rem;
      /* Headroom for the over-the-row arch route (the flagged edge exits the
         card TOPS and runs through this band — never across a card). */
      padding-top: 2.5rem;
    }
  }
  @media (min-width: 58rem) {
    .cxn__nodes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* The stable 3×2 rows from the data (COMPETENCY_GRID inline props): top =
       Red Team / Vuln Research / AI·LLM Security, bottom = Platforms &
       Internals / Purple Team / AI-Assisted (the brief's mandated rows). */
    .cxn__item {
      grid-column: var(--cxn-col);
      grid-row: var(--cxn-row);
    }
  }

  /* Card face: dark OPAQUE console surface, thin border, 3–5px radius (the
     brief's card treatment). The transparent offset outline is the SECOND
     contour of the active state — pre-declared so only its colour flips
     (transitionable under full motion, instant under reduced). */
  .cxn__node {
    background: var(--surface-code);
    border: 1px solid var(--mx-green-far);
    border-radius: 4px;
    outline: 1px solid transparent;
    outline-offset: 3px;
  }
  .cxn__node[data-accent='purple'] {
    border-color: color-mix(in srgb, var(--note-accent) 45%, transparent);
  }
  /* ACTIVE (hover / keyboard focus / open — the three the brief names;
     :has(:focus-visible) and NOT :focus-within, so the residual focus a mouse
     click leaves on a summary never pins the map's dim — see the generator
     note in src/data/competencies.ts): double contour = bright border + the
     offset outline ring, plus the ONE restrained glow the section allows
     (active node, endpoints, routes). Never colour alone: contour + edge
     thickness + luminosity + the dim of the unrelated remainder all move
     together. */
  .cxn__node:hover,
  .cxn__node:has(:focus-visible),
  .cxn__node[open] {
    border-color: var(--mx-green);
    outline-color: color-mix(in srgb, var(--mx-green) 72%, transparent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--mx-green) 18%, transparent);
  }
  .cxn__node[data-accent='purple']:hover,
  .cxn__node[data-accent='purple']:has(:focus-visible),
  .cxn__node[data-accent='purple'][open] {
    border-color: var(--note-accent);
    outline-color: color-mix(in srgb, var(--note-accent) 72%, transparent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--note-accent) 24%, transparent);
  }
  :global(html[data-motion='full']) .cxn__node {
    transition:
      border-color 0.25s ease,
      outline-color 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.3s ease;
  }

  /* The card face — internal header (title row + degree), the icon tile
     beside the tagline, and the preview tools as an aligned footer (the
     brief's card anatomy). The WHOLE summary is the actionable area. The
     .cxn__head wrapper goes display:contents so the h3 and the tagline become
     grid items of the summary directly (a plain span — no semantics lost). */
  .cxn__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'title title degree'
      'badge tagline tagline'
      'preview preview preview';
    gap: 0.5rem 0.6rem;
    align-items: start;
    padding: 0.7rem 0.8rem;
    cursor: pointer;
    list-style: none;
  }
  .cxn__summary::-webkit-details-marker {
    display: none;
  }
  .cxn__summary:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .cxn__badge {
    grid-area: badge;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--mx-green-dim);
    border-radius: 4px;
    color: var(--mx-green);
    font-size: 1rem;
  }
  .cxn__node[data-accent='purple'] .cxn__badge {
    border-color: var(--note-accent);
    color: var(--note-accent);
  }
  .cxn__head {
    display: contents;
  }
  .cxn__title {
    grid-area: title;
    margin: 0;
    color: var(--mx-green-hi);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .cxn__tagline {
    grid-area: tagline;
    display: block;
    align-self: center;
    color: var(--mx-green-mid);
    font-size: 0.68rem;
    line-height: 1.45;
  }
  .cxn__degree {
    grid-area: degree;
    align-self: start;
    color: var(--mx-green-mid);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .cxn__node[data-accent='purple'] .cxn__degree {
    color: color-mix(in srgb, var(--note-accent) 80%, transparent);
  }
  /* A caret cue that turns on open — decorative (aria-hidden span). */
  .cxn__chevron {
    grid-area: degree;
    justify-self: end;
    align-self: end;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--mx-green-dim);
  }
  .cxn__node[open] .cxn__chevron {
    border-top-color: var(--mx-green);
    transform: rotate(180deg);
  }
  :global(html[data-motion='full']) .cxn__chevron {
    transition: transform 0.25s ease;
  }
  .cxn__preview {
    grid-area: preview;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  /* Hide the preview tools once the node is open (the full list shows below). */
  .cxn__node[open] .cxn__preview {
    display: none;
  }
  .cxn__preview-chip {
    border: 1px solid var(--mx-green-far);
    border-radius: 3px;
    padding: 0.06rem 0.34rem;
    color: var(--mx-green-mid);
    font-size: 0.6rem;
    letter-spacing: 0.02em;
  }

  /* The expanded detail (native <details> reveals it on open). In-flow on the
     grid, so it grows the card and the row naturally — content-driven heights
     everywhere, no scroll cap (the old absolute canvas needed one; the
     measured connectors re-run on the resize). */
  .cxn__detail {
    display: grid;
    gap: 0.6rem;
    margin: 0 0.8rem 0.8rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--mx-green-far);
  }
  .cxn__desc {
    margin: 0;
    color: var(--mx-green-hi);
    font-size: 0.74rem;
    line-height: 1.55;
  }
  .cxn__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .cxn__chip {
    max-width: 100%;
    overflow-wrap: break-word;
    border: 1px solid var(--mx-green-far);
    border-radius: 3px;
    padding: 0.08rem 0.36rem;
    color: var(--mx-green-mid);
    font-size: 0.64rem;
  }
  .cxn__rels-title {
    margin: 0.1rem 0 0;
    color: var(--mx-green-mid);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cxn__rels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .cxn__rel {
    position: relative;
    padding-left: 0.9rem;
    font-size: 0.68rem;
    line-height: 1.45;
  }
  .cxn__rel::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--mx-green);
  }
  .cxn__node[data-accent='purple'] .cxn__rel::before {
    color: var(--note-accent);
  }
  .cxn__rel-node {
    color: var(--mx-green);
    font-weight: 600;
  }
  .cxn__rel-label {
    color: var(--mx-green-hi);
  }
  .cxn__rel-node::after {
    content: ' — ';
    color: var(--mx-green-dim);
  }
  /* Discreet technical pulse on the selected node's badge (P5: full motion only;
     reduced-motion rests on the static open border/glow). Flash-safe: one gentle
     ring per 2.6s (≈0.38/s ≪ 3/s), box-shadow only, no inversion. FINITE (two
     rings) since Ruta Activa serves Red Team [open] at rest — an infinite loop
     here would run forever at load and break the pinned page-wide
     running-infinite census (8 names). */
  :global(html[data-motion='full']) .cxn__node[open] .cxn__badge {
    animation: cxn-pulse 2.6s ease-out 2;
  }
  @keyframes cxn-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--mx-green) 40%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 7px color-mix(in srgb, var(--mx-green) 0%, transparent);
    }
  }

  /* Small legend (aria-hidden — the connections are also stated in text). */
  .cxn__legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.3rem;
    margin: 1.1rem 0 0;
    padding: 0;
    color: var(--mx-green-mid);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
  }
  .cxn__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .cxn__legend-line {
    width: 1.5rem;
    border-top: 2px solid var(--mx-green-dim);
  }
  .cxn__legend-line--purple {
    border-top-color: var(--note-accent);
  }

  /* (The old ≤52rem constellation-collapse block is gone: the grid above is
     mobile-FIRST — base = the stacked single column with the SVG hidden and
     the dim neutralized; the ≥40rem/≥58rem tiers add the map.) */

  /* --- Skills — "CHANNEL STACK + DIAGNOSTIC MODE" (2026-08-09 owner
     redesign; SUPERSEDES the 2026-08-08 Skill Tree connector grid FOR THIS
     SECTION — same panel discipline, same data, new architecture; the tree's
     rules live in git history). The section is a hardware signal board:
       • a left DIAGNOSTIC CONSOLE (dl: STATUS / FOCUS / ARROW KEYS) on
         --surface-code fields with dotted derivations into the layout gap;
       • an aria-hidden SKILLS root node dropping a trunk onto the matrix;
       • the nine category MODULES on a 3/2/1-column grid, each header riding
         a horizontal CHANNEL line (a FIXED y from the module top — grid rows
         top-align their items, so the line is collinear across a row by
         construction, header-wrap-proof) into the next module (arrow cap)
         or, at row end, into
       • the RIGHT VERTICAL BUS (one square junction per row).
     CONNECTORS ARE GEOMETRY, NOT CONTENT (the Skill Tree rule kept): every
     line/cap is background paint on a pseudo-element derived from the grid —
     no per-content coordinates, no JS measurement, no SVG, nothing in the
     a11y tree. The caps are gradient layers (a conic-sector arrowhead, a
     square junction) — no glyph fonts, so headless/system-font environments
     render them identically. The row-end partition is a per-tier nth-child
     formula (rows of 3 / rows of 2 + the lone :nth-child(9) / none) — a 10th
     category would auto-flow correctly; only its last-row junction waits for
     a formula update (noted, accepted — the census is schema-stable at 9).
     ACTIVE STATE (Diagnostic Mode): [data-active] is the roving-tabindex stop
     skills-console.ts manages (SSR'd on the first module so no-JS matches the
     console's SSR FOCUS text). Signals are MULTIPLE, never colour alone: a
     border-triangle caret on the left edge, a literal double border (brighter
     border + a void-gap ring + a second line ring — 0-blur LINE shadows, not
     glow), a brighter header band with a faint fill, and the module's own
     outgoing channel/junction re-lit via one --skl-line flip. :focus-visible
     keeps the house ring OUTSIDE the double border (outline offset past the
     rings — decoration never repaints the a11y ring, the cover-flow cascade
     rule). Transitions ride html[data-motion='full'] only; the calm path
     flips instantly and the section ships ZERO animations on either path.
     P6 (in-situ, code-over-panel composite): item text --mx-green-hi ≈17.9:1,
     headers --mx-green ≈14.7:1, console labels / counts / descs
     --mx-green-mid ≈7.5:1; the --skl-line channels are decoration-grade
     (recorded, not gated — US-1705). P7: ramp tokens only. --- */
  .skills {
    /* Channel knobs (owner-tunable): line colour, the channel y (fixed offset
       from each module top), row/column gaps, the bus lane reserved right of
       the matrix + the bus inset inside it, and the root trunk drop. */
    --skl-line: var(--mx-green-dim);
    --skl-chan-y: 1.05rem;
    --skl-gap: 1.35rem;
    --skl-col-gap: 1.35rem;
    --skl-con-gap: 1.6rem;
    --skl-bus-lane: 1.7rem;
    --skl-bus-x: 0.4rem;
    --skl-trunk: 1.15rem;
    position: relative;
    /* Stacking context on purpose: the frame pseudos sit at z -1 — above the
       panel fill, below every child (decoration behind content, always). */
    z-index: 0;
    display: grid;
    grid-template-columns: minmax(9.5rem, 12rem) minmax(0, 1fr);
    column-gap: var(--skl-con-gap);
    row-gap: 1.4rem;
    align-items: start;
    background: var(--crt-lines-matrix), var(--surface-panel);
    border: 1px solid var(--mx-green-dim);
    padding: 1.6rem 1.5rem 1.7rem;
  }
  /* The technical frame — corner brackets (the top-left pair runs longer: the
     brief's "slightly asymmetric") + a subtle right-edge tick ruler, all
     background layers on one pseudo. */
  .skills::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    pointer-events: none;
    background-repeat: no-repeat;
    background-image:
      linear-gradient(var(--mx-green) 0 0),
      linear-gradient(var(--mx-green) 0 0),
      linear-gradient(var(--mx-green) 0 0),
      linear-gradient(var(--mx-green) 0 0),
      linear-gradient(var(--mx-green) 0 0),
      linear-gradient(var(--mx-green) 0 0),
      linear-gradient(var(--mx-green) 0 0),
      linear-gradient(var(--mx-green) 0 0),
      repeating-linear-gradient(
        to bottom,
        transparent 0 1.35rem,
        color-mix(in srgb, var(--mx-green-dim) 55%, transparent) 1.35rem calc(1.35rem + 1px)
      );
    background-position:
      0 0,
      0 0,
      100% 0,
      100% 0,
      0 100%,
      0 100%,
      100% 100%,
      100% 100%,
      100% 1.2rem;
    background-size:
      1.6rem 2px,
      2px 1.6rem,
      0.9rem 2px,
      2px 0.9rem,
      0.9rem 2px,
      2px 0.9rem,
      0.9rem 2px,
      2px 0.9rem,
      3px calc(100% - 2.4rem);
  }
  /* Ambient matrix characters — pseudo CONTENT (zero DOM, invisible to
     alien-decode by construction) with the alt-'' syntax: string generated
     content IS exposed to AT otherwise (the `content: '> ' / ''` house
     precedent; review finding). Faint, always behind the content. */
  .skills::after {
    content: '01 110 0\A10 011 1\A00 101 0' / '';
    position: absolute;
    top: 0.55rem;
    right: 1.15rem;
    z-index: -1;
    color: var(--mx-green-dim);
    opacity: 0.42;
    font-size: 0.5rem;
    line-height: 1.55;
    letter-spacing: 0.22em;
    white-space: pre;
    text-align: right;
    pointer-events: none;
  }
  /* --- The diagnostic console. dl/dt/dd semantics (the aero summary-rail
     precedent); fields on --surface-code so the labels' green-mid reads ≈7.5:1
     (the US-1607 "P6 decides the surface" rule). The FOCUS/STATUS values live
     in .skills__value spans that alien-decode excludes BY CLASS — so the
     runtime mirror can never collide with pair spans (see skills-console.ts;
     spans, not <code>: role=code would be announced on localized prose). */
  .skills__console {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    /* Owner call 2026-08-10: the two fields sit vertically CENTERED beside
       the matrix (the grid row's height is the taller stack column, so
       align-self centers within it; inert at the stacked mobile tier). */
    align-self: center;
  }
  .skills__field {
    position: relative;
    background: var(--surface-code);
    border: 1px solid var(--mx-green-dim);
    padding: 0.55rem 0.7rem 0.6rem;
  }
  /* Dotted derivation into the console↔matrix gap — decoration (hidden when
     the layout stacks). */
  .skills__field::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: calc(var(--skl-con-gap) - 0.35rem);
    border-top: 1px dashed color-mix(in srgb, var(--skl-line) 70%, transparent);
  }
  .skills__field-label {
    margin: 0;
    color: var(--mx-green-mid);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .skills__field-value {
    margin: 0.4rem 0 0;
  }
  .skills__value {
    display: block;
    color: var(--mx-green-hi);
    font-size: 0.74rem;
    font-weight: 600;
    /* explicit so the stacked tier's 3em two-line reservation stays exact */
    line-height: 1.5;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  /* --- Root node + trunk (diagram chrome — aria-hidden, non-interactive,
     must not look clickable). Straight corners (the channel-stack language);
     the trunk carries a junction square at its base — the bus grammar's
     opening statement. box-sizing beside max-width:100% (the banda-compacta
     lesson: no global box-sizing reset in this codebase). */
  .skills__stack {
    position: relative;
    min-width: 0;
  }
  .skills__root {
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    margin: 0 auto;
    position: relative;
    padding: 0.4rem 1.4rem;
    background: var(--surface-code);
    border: 1px solid var(--mx-green);
    color: var(--mx-green-hi);
    font-size: clamp(0.85rem, 1.5vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    overflow-wrap: break-word;
  }
  /* The trunk hangs off the GRID (bottom:100% spans exactly the margin-top
     gap up to the root's bottom edge by construction) — NEVER off the root:
     the root is an alien-decode HOST, and the encode pin's overflow:hidden
     would clip an out-of-box root pseudo for the whole encoded phase (the
     US-1705 non-host-pseudo rule; review finding). */
  .skills__grid::after {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 7px;
    height: var(--skl-trunk);
    background:
      linear-gradient(var(--skl-line) 0 0) 50% 100% / 7px 7px no-repeat,
      linear-gradient(var(--skl-line) 0 0) 50% 0 / 1px 100% no-repeat;
  }
  /* --- The module matrix. The right BUS is absolute (never a grid item — the
     US-1705 trap), running from the row-1 channel line to the grid bottom
     inside the reserved bus lane (the grid's padding-right). */
  .skills__grid {
    list-style: none;
    margin: var(--skl-trunk) 0 0;
    padding: 0 var(--skl-bus-lane) 0 0;
    position: relative;
    display: grid;
    /* minmax(0, 1fr): the US-036 grid-blowout rule. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--skl-gap) var(--skl-col-gap);
  }
  .skills__grid::before {
    content: '';
    position: absolute;
    top: var(--skl-chan-y);
    bottom: 0;
    right: var(--skl-bus-x);
    width: 1px;
    background: var(--skl-line);
  }
  .skills__mod {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--surface-code);
    border: 1px solid var(--mx-green-dim);
    /* The roving stops are FOCUS SCROLL TARGETS — the house header-clearance
       convention applies (an arrow move can scroll a tall module's top under
       the sticky band otherwise; review finding, verified fix). */
    scroll-margin-top: var(--header-clearance, 5rem);
  }
  /* Hover is a decoration-only cue (nothing depends on it — the brief); the
     pointer signals the click-to-focus affordance, so it is GATED on the
     module being wired (no-JS must not advertise a dead click target). */
  @media (hover: hover) {
    .skills[data-skills-ready] .skills__mod:hover {
      border-color: var(--mx-green);
      cursor: pointer;
    }
  }
  /* The channel — every module's header line runs right: into the next module
     (conic-sector ARROW cap) or, at row end (:nth-child(3n) at this tier),
     into the bus (SQUARE junction cap). Painted with --skl-line so the active
     module re-lights its own connection with one custom-property flip. The
     arrow cap itself rides --skl-cap (declared ONLY here; the tier resets
     re-read it) so the retraction rule below can drop an arrowhead without
     touching any square-junction rule at any tier. */
  .skills__mod::after {
    content: '';
    position: absolute;
    top: var(--skl-chan-y);
    left: 100%;
    transform: translateY(-50%);
    height: 7px;
    width: var(--skl-col-gap);
    pointer-events: none;
    --skl-cap: conic-gradient(
        from 235deg at 100% 50%,
        var(--skl-line) 0 70deg,
        transparent 70deg
      )
      100% 50% / 5px 7px no-repeat;
    background:
      var(--skl-cap),
      linear-gradient(var(--skl-line) 0 0) 0 50% / 100% 1px no-repeat;
  }
  /* When the NEXT module is the active one, its caret takes the arrowhead's
     place on the same channel — retract the incoming arrow to a clean line
     (custom-property flip: square-junction rules never read --skl-cap, so
     row-end branches are untouched at every tier). */
  .skills__mod:has(+ .skills__mod[data-active])::after {
    --skl-cap: none;
  }
  .skills__mod:nth-child(3n)::after {
    width: calc(var(--skl-bus-lane) - var(--skl-bus-x) + 4px);
    background:
      linear-gradient(var(--skl-line) 0 0) 100% 50% / 7px 7px no-repeat,
      linear-gradient(var(--skl-line) 0 0) 0 50% / 100% 1px no-repeat;
  }
  /* ACTIVE (the roving stop): caret + double border + brighter header + the
     re-lit connection — shape/border/position signals, never colour alone. */
  .skills__mod[data-active] {
    --skl-line: var(--mx-green);
    border-color: var(--mx-green);
    box-shadow:
      0 0 0 2px var(--mx-void),
      0 0 0 3px var(--mx-green-dim);
  }
  .skills__mod[data-active]::before {
    content: '';
    position: absolute;
    top: var(--skl-chan-y);
    /* -1.05rem clears the :focus-visible ring's 5–7px band (the ring must
       never cross the caret — review finding) and still fits the 1rem mobile
       panel padding; the retraction rule above frees this zone of the
       incoming arrowhead. */
    left: -1.05rem;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-block: 0.32rem solid transparent;
    border-left: 0.5rem solid var(--mx-green);
  }
  .skills__mod:focus-visible {
    outline: 2px solid var(--focus-ring);
    /* clears the double-border rings — a11y ring never merges into
       decoration */
    outline-offset: 5px;
  }
  .skills__mod[data-active] .skills__mod-title {
    color: var(--mx-green-hi);
    background: color-mix(in srgb, var(--mx-green) 12%, transparent);
    border-bottom-color: var(--mx-green-dim);
  }
  :global(html[data-motion='full']) .skills__mod {
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }
  :global(html[data-motion='full']) .skills__mod-title {
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  /* Header band — the category as a real <h3> (data-sourced, bilingual via
     pick). The aria-hidden [N] badge is items.length, never authored (P3);
     its accessible alternative is the leaf list itself. */
  .skills__mod-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7ch;
    margin: 0;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--mx-green-far);
    color: var(--mx-green);
    font-size: clamp(0.7rem, 1vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  /* The shared '> ' h3 prompt prefix (US-604) reads as a dangling command
     marker on a channel header — suppressed HERE only (the US-1706
     precedent). */
  .skills__mod-title::before {
    content: none;
  }
  .skills__mod-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .skills__mod-count {
    flex: none;
    color: var(--mx-green-mid);
    font-weight: 400;
    font-size: 0.86em;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }
  /* Items — verbatim cv.json (P3). Square bullets are an EMPTY pseudo box (no
     glyph fonts), inside the host's padding box so the decode pin's
     overflow:hidden can never clip it (US-1711). The ' — ' lead/desc emphasis
     renders INLINE (continuous wrapped text — the reference's own setting);
     desc --mx-green-mid ≈7.5:1 on this composite (P6). */
  .skills__items {
    list-style: none;
    margin: 0;
    padding: 0.6rem 0.7rem 0.75rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    font-size: clamp(0.72rem, 1vw, 0.8rem);
    line-height: 1.5;
  }
  .skills__item {
    margin: 0;
    position: relative;
    padding-left: 0.95rem;
    color: var(--mx-green-hi);
    overflow-wrap: anywhere;
  }
  .skills__item::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.45em;
    width: 0.28rem;
    height: 0.28rem;
    background: var(--mx-green);
  }
  .skills__item-lead {
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .skills__item-desc {
    color: var(--mx-green-mid);
  }
  /* --- Responsive. Tablet: compact lateral console + 2-column matrix (the
     channel caps re-partition to rows of 2 with the lone :nth-child(9)
     crossing its empty cell to the bus — tier rules open with the
     specificity-matching :nth-child(n) so the base 3n square rule can't
     outrank, the banda-compacta rule). Mobile: console ABOVE the matrix (the
     DOM order — visual / DOM / tab order coincide), one column, bus +
     channels + derivations simplified away (lines never overlap text); the
     caret survives as the active cue. SAME DOM at every width. */
  @media (max-width: 56rem) {
    .skills {
      --skl-con-gap: 1.1rem;
      grid-template-columns: minmax(7.5rem, 9rem) minmax(0, 1fr);
    }
    .skills::after {
      content: none;
    }
    .skills__field {
      padding: 0.45rem 0.55rem 0.5rem;
    }
    .skills__value {
      font-size: 0.68rem;
    }
    .skills__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .skills__mod:nth-child(n)::after {
      width: var(--skl-col-gap);
      /* re-reads --skl-cap (declared in the base rule only) so the active-
         neighbour retraction keeps working at this tier */
      background:
        var(--skl-cap),
        linear-gradient(var(--skl-line) 0 0) 0 50% / 100% 1px no-repeat;
    }
    .skills__mod:nth-child(2n)::after,
    .skills__mod:nth-child(9)::after {
      width: calc(var(--skl-bus-lane) - var(--skl-bus-x) + 4px);
      background:
        linear-gradient(var(--skl-line) 0 0) 100% 50% / 7px 7px no-repeat,
        linear-gradient(var(--skl-line) 0 0) 0 50% / 100% 1px no-repeat;
    }
    .skills__mod:nth-child(9)::after {
      width: calc(100% + var(--skl-col-gap) + var(--skl-bus-lane) - var(--skl-bus-x) + 4px);
    }
  }
  @media (max-width: 40rem) {
    .skills {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.25rem 1rem 1.35rem;
    }
    .skills__console {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.7rem;
    }
    .skills__field {
      flex: 1 1 8rem;
      min-width: 0;
    }
    .skills__field::after {
      content: none;
    }
    .skills__grid {
      grid-template-columns: minmax(0, 1fr);
      padding-right: 0;
    }
    .skills__grid::before {
      content: none;
    }
    .skills__mod:nth-child(n)::after {
      content: none;
    }
    /* FOCUS readout height reservation — the stacked console sits ABOVE the
       matrix here, so a 1↔2-line title swap would shift the grid under the
       user's finger (the aero min-inline-size:7ch class of fix). 3em at the
       value's own 1.5 line-height = exactly two lines, the measured EN/ES
       wrap bound at this tier. */
    .skills__value[data-skills-focus] {
      min-block-size: 3em;
    }
  }
  /* --- Experience — "08 — Chapter Path" (2026-08-08 redesign; supersedes the
     US-020 flat timeline + US-705 collapse cards). ONE master–detail console:
     the chapter INDEX (left, ~1/3) rides the chronological rail — node dots +
     spine segments carrying the US-1710 pastel severity ramp via the SAME
     --sev-node/--sev-spine custom properties (P7 amendment surface is now
     .exp__chapter::before/::after; recorded in theme.css / CLAUDE.md / the
     manual) — and the DETAIL panel (right) shows one chapter in full on the
     denser --surface-code (94% void), the established console reading surface
     (the US-1607 "P6 decides the surface" rule). The outer .exp keeps the
     house 80% panel + CRT lines, so the ambient texture stays subordinate
     behind the reading zones.
     STATE MODEL — two orthogonal states, never conflated:
       • SELECTED (UI state): aria-current='true' on the index button — border
         + raised fill + a 2px inset left bar (three visual signals + the
         semantic attribute);
       • CURRENT (professionally active, data-exp-current from the typed
         endYear literal): the ACTIVE badge TEXT + a FILLED node dot (vs the
         void-filled ring of completed chapters) — text + shape, never colour
         alone (WCAG 1.4.1).
     PROGRESSIVE-ENHANCEMENT GATE: .exp:not([data-exp-ready]) is the no-JS /
     pre-enhancement state — single column, index + footer hidden (no dead
     controls), all four panels stacked with hairline separators; the module
     stamps data-exp-ready only AFTER wiring (the collapse.ts P5 idiom).
     Motion: the selection eases + the one-shot panel entrance live ONLY under
     html[data-motion='full'] (finite — the running-infinite census is
     untouched); under data-motion='reduced' every state flips instantly.
     No fixed heights anywhere: the detail stretches with the grid row and
     panels grow with content. --- */
  .exp {
    display: grid;
    grid-template-columns: minmax(15rem, 32%) minmax(0, 1fr);
    gap: 1.4rem;
    align-items: stretch;
    padding: 1.5rem;
    background: var(--crt-lines-matrix), var(--surface-panel);
    border: 1px solid var(--mx-green-far);
    border-radius: 4px;
  }
  /* No-JS / pre-enhancement: a clean linear document — no dead controls. */
  .exp:not([data-exp-ready]) {
    display: block;
  }
  .exp:not([data-exp-ready]) .exp__side,
  .exp:not([data-exp-ready]) .exp__nav {
    display: none;
  }
  .exp:not([data-exp-ready]) .exp__panel + .exp__panel {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--mx-green-far);
  }
  /* Stacked fallback below ~720px: the compact index strip on top, the
     selected chapter directly below — SAME DOM, no duplicated markup. */
  @media (max-width: 45rem) {
    .exp {
      display: block;
      padding: 0.95rem;
    }
    .exp__side {
      margin-bottom: 1.1rem;
    }
  }
  .exp__side {
    min-width: 0;
  }
  .exp__index {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .exp__chapter {
    position: relative;
    padding: 0 0 0.55rem 1.7rem;
  }
  .exp__chapter:last-child {
    padding-bottom: 0;
  }
  /* US-1710 (derivation unchanged): node + rail segment take their slice of
     the pastel severity ramp from the per-entry custom properties — non-text
     decoration only (the P7 amendment), aria-hidden by construction
     (pseudo-elements). Fallbacks keep the green look if an entry ever renders
     without them. The CURRENT chapter's node FILLS (shape signal beside the
     ACTIVE badge text); completed nodes stay void-filled rings. */
  .exp__chapter::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1rem;
    width: 0.7rem;
    height: 0.7rem;
    box-sizing: border-box;
    border-radius: 50%;
    background: var(--mx-void);
    border: 2px solid var(--sev-node, var(--mx-green));
    z-index: 1;
  }
  .exp__chapter[data-exp-current]::before {
    background: var(--sev-node, var(--mx-green));
  }
  .exp__chapter::after {
    content: '';
    position: absolute;
    left: calc(0.35rem - 1px);
    top: 1.85rem;
    bottom: -1.1rem;
    width: 2px;
    background: var(--sev-spine, var(--mx-green-dim));
  }
  .exp__chapter:last-child::after {
    display: none;
  }
  /* The index entry — a REAL button (selection changes same-page content).
     font:inherit because buttons don't inherit type; the theme.css
     :focus-visible ring is untouched (US-046). */
  .exp__tab {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0.55rem 0.7rem;
    min-height: 44px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
    text-align: start;
    cursor: pointer;
  }
  :global(html[data-motion='full']) .exp__tab {
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }
  .exp__tab:hover {
    border-color: var(--mx-green-far);
    background: color-mix(in srgb, var(--mx-green-far) 30%, transparent);
  }
  .exp__tab[aria-current='true'] {
    border-color: var(--mx-green-dim);
    background: color-mix(in srgb, var(--mx-green-far) 45%, transparent);
    box-shadow: inset 2px 0 0 var(--mx-green);
  }
  .exp__tab-head {
    display: flex;
    align-items: baseline;
    gap: 0.7ch;
    min-width: 0;
  }
  .exp__tab-num {
    flex: none;
    color: var(--mx-green-mid);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }
  .exp__tab-org {
    min-width: 0;
    color: var(--mx-green);
    font-weight: 600;
    font-size: clamp(0.92rem, 1.6vw, 1.02rem);
    letter-spacing: 0.04em;
    /* `anywhere` (never break-word): only anywhere shrinks the min-content
       contribution, so an unbroken org token can't blow the flex row out of
       the index column (the US-1706 rule). */
    overflow-wrap: anywhere;
  }
  .exp__tab-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.7rem;
    margin-top: 0.25rem;
  }
  .exp__tab-role {
    min-width: 0;
    color: var(--mx-green-hi);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  /* The status badge — metadata, quieter than org/role by design. ACTIVE
     brightens (text difference is the primary signal, WCAG 1.4.1). */
  .exp__tab-badge {
    flex: none;
    padding: 0.08rem 0.4rem;
    border: 1px solid var(--mx-green-dim);
    border-radius: 3px;
    color: var(--mx-green-mid);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    line-height: 1.6;
  }
  .exp__chapter[data-exp-current] .exp__tab-badge {
    border-color: var(--mx-green);
    color: var(--mx-green);
  }
  .exp__tab-period {
    display: block;
    margin-top: 0.2rem;
    color: var(--mx-green);
    opacity: 0.8;
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }
  /* The detail panel — flex column so the prev/next footer pins to the bottom
     of the stretched grid row (margin-top:auto), never a fixed height. */
  .exp__detail {
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--surface-code);
    border: 1px solid var(--mx-green-far);
    border-radius: 4px;
    padding: 1.4rem 1.5rem 0;
  }
  @media (max-width: 45rem) {
    .exp__detail {
      padding: 1rem 1rem 0;
    }
  }
  .exp__panel {
    min-width: 0;
    padding-bottom: 1.4rem;
  }
  /* Belt-and-braces: author display on the panel must never beat the UA
     [hidden] rule (the panels toggle via the hidden property). */
  .exp__panel[hidden] {
    display: none;
  }
  :global(html[data-motion='full']) .exp__panel[data-exp-enter] {
    animation: exp-chapter-in 180ms ease-out;
  }
  @keyframes exp-chapter-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .exp__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--mx-green-mid);
  }
  /* Org = the dominant voice of the detail (the h3 keeps the shared '> '
     prompt prefix — house terminal identity). Role clearly visible but
     subordinate. Long values wrap (overflow-wrap), never truncate. */
  .exp__org {
    margin: 0;
    color: var(--mx-green);
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .exp__role {
    margin: 0.3rem 0 0;
    color: var(--mx-green-hi);
    font-size: clamp(0.95rem, 1.8vw, 1.08rem);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  /* PERIOD — a real <dl> (key/value semantics), hairline-ruled above
     and below (the mockup's meta band). Wraps to a column at narrow widths
     via flex-wrap; no vertical divider (wrap-fragile — recorded decision). */
  .exp__meta {
    margin: 1.05rem 0 0;
    padding: 0.8rem 0;
    border-top: 1px solid var(--mx-green-far);
    border-bottom: 1px solid var(--mx-green-far);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 2.4rem;
  }
  .exp__meta-item {
    display: flex;
    align-items: baseline;
    gap: 0.7ch;
    min-width: 0;
  }
  .exp__meta-key {
    color: var(--mx-green-mid);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
  }
  .exp__meta-val {
    margin: 0;
    color: var(--mx-green-hi);
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .exp__group {
    margin-top: 1rem;
  }
  .exp__group--hl {
    margin-top: 1.05rem;
    border-top: 1px solid var(--mx-green-far);
    padding-top: 1rem;
  }
  .exp__label {
    margin: 0 0 0.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--mx-green-mid);
  }
  /* Tags: SECONDARY metadata (the redesign brief) — quiet outline chips on a
     faint far fill, wrapping freely; the muted articles mix keeps the label
     ≥4.5:1 on the code surface. Non-interactive <li>s, never focusable. */
  .exp__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .exp__tag {
    max-width: 100%;
    padding: 0.22rem 0.6rem;
    background: color-mix(in srgb, var(--mx-green-far) 30%, transparent);
    border: 1px solid var(--mx-green-dim);
    border-radius: 4px;
    color: color-mix(in srgb, var(--mx-green-mid) 55%, var(--mx-green-hi));
    font-size: clamp(0.7rem, 1.2vw, 0.78rem);
    letter-spacing: 0.05em;
    line-height: 1.5;
    /* Flex-item chip: `anywhere` so an unbroken token shrinks min-content and
       wraps inside the row instead of blowing it out (US-1706). */
    overflow-wrap: anywhere;
  }
  /* Highlights: the UNORDERED set within a role (no ranking ⇒ <ul>), measure
     capped for reading comfort — a cap on the LIST width, not a fixed height.
     minmax(0,1fr) is the canonical grid-blowout guard (US-036) and `anywhere`
     lets a pasted URL/long token break safely (both proven by the long-content
     fixture sweep — break-word alone left a 293px doc overflow). */
  .exp__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
    max-width: 46rem;
  }
  .exp__highlight {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mx-green-hi);
    font-size: clamp(0.84rem, 1.5vw, 0.94rem);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .exp__highlight::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--mx-green);
  }
  /* Prev/next — real buttons with REAL disabled at the ends (dim + no hover
     is the visual echo; the attribute is the state). The count between them
     is one SSR span per chapter, hidden-toggled (data-derived, zero JS
     strings). */
  .exp__nav {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    border-top: 1px solid var(--mx-green-far);
    padding: 0.55rem 0;
  }
  /* On phones the count takes its own full-width line above the arrows so the
     footer can never overflow a 320px viewport. */
  @media (max-width: 30rem) {
    .exp__nav {
      flex-wrap: wrap;
      padding-top: 0.7rem;
    }
    .exp__count {
      order: -1;
      flex: 1 0 100%;
    }
  }
  .exp__nav-btn {
    flex: none;
    margin: 0;
    padding: 0.6rem 0.7rem;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--mx-green);
    cursor: pointer;
  }
  :global(html[data-motion='full']) .exp__nav-btn {
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }
  .exp__nav-btn:hover:enabled {
    color: var(--mx-green-hi);
    background: color-mix(in srgb, var(--mx-green-far) 35%, transparent);
  }
  .exp__nav-btn:disabled {
    color: var(--mx-green-mid);
    opacity: 0.55;
    cursor: default;
  }
  .exp__count {
    margin: 0;
    min-width: 0;
    text-align: center;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--mx-green-mid);
  }
  .exp__count-item[hidden] {
    display: none;
  }

  /* --- Articles (US-022 → 2026-08-08 editorial-stack restyle): the 2 published
     write-ups from cv.json.articles as an EDITORIAL STACK — one wide open row
     per article (oversized thin 01/02 numeral lane | kicker / title / meta /
     optional dek), fine dashed rules between rows, NO closed cards / per-row
     fills / brackets / scan (the rows left the US-604 card grammar). The
     section panel keeps the house 80%-void surface + CRT lines, so P6 rides
     the panel alone: in situ over the brightest rain head the title
     (--mx-green) reads ≈8.9:1 and the muted roles (the mid→hi mix below)
     ≈6:1; the numeral + dashed rules + middot are aria-hidden / non-text
     decoration (recorded, exempt). Ramp tokens only (P7). No reveal motion
     here; US-026 owns that. --- */
  .articles {
    /* The muted editorial register: green-mid ALONE reads ≈4.5:1 (thin) on the
       bare 80% panel (the theme.css doctrine), so the pale kicker/meta/dek mix
       toward green-hi — still desaturated, comfortably clear of the floor. */
    --articles-muted: color-mix(in srgb, var(--mx-green-mid) 55%, var(--mx-green-hi));
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.75rem;
    background: var(--crt-lines-matrix), var(--surface-panel);
    border: 1px solid var(--mx-green-far);
    border-radius: 4px;
  }
  /* One wide row per article: a two-column grid (numeral lane | content), the
     content track minmax(0, 1fr) — the standard grid-blowout guard so the long
     Cisco title can never stretch the track (US-036/US-1706). The lane clamp
     lands in the reference's 110–160px band. position:relative makes the row
     the containing block for the stretched link ::after below. */
  .articles__row {
    position: relative;
    display: grid;
    grid-template-columns: clamp(7rem, 12vw, 10rem) minmax(0, 1fr);
    column-gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    padding-block: clamp(1.3rem, 3vw, 1.85rem);
  }
  /* The fine technical rule between rows — dashed, `+`-combined so the stack
     opens and closes flush with the panel edge. Decorative non-text (WCAG
     1.4.11 exempts pure decoration; recorded for retune): hover/focus brighten
     it to --mx-green-dim, an instant colour flip on both motion paths. */
  .articles__row + .articles__row {
    border-top: 1px dashed color-mix(in srgb, var(--mx-green-dim) 55%, var(--mx-green-far));
  }
  .articles__row:hover,
  .articles__row:has(.articles__link:focus-visible),
  .articles__row:hover + .articles__row,
  .articles__row:has(.articles__link:focus-visible) + .articles__row {
    border-top-color: var(--mx-green-dim);
  }
  /* The oversized numeral: decorative, presentational 01/02 (aria-hidden — the
     <ul> is an unordered set, so no order claim reaches AT; alien decode gives
     it slots but no sr final, the aria-hidden rule). The thin stroke is the
     400-weight body face at display size — never a synthetic light weight (no
     lighter face ships). Hover intensifies it (colour flip, both paths). */
  .articles__no {
    grid-column: 1;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(3.1rem, 6.5vw, 4.6rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--mx-green);
    opacity: 0.72;
  }
  .articles__row:hover .articles__no,
  .articles__row:has(.articles__link:focus-visible) .articles__no {
    color: var(--mx-green-hi);
    opacity: 1;
  }
  .articles__content {
    grid-column: 2;
    min-width: 0;
  }
  /* The kicker: the one new P8 string (labels.article). aria-hidden — pure
     repetition for AT (the section h2 already names the set) — but visible
     text, so it is localized and held to the ≥4.5:1 text floor anyway. */
  .articles__kicker {
    margin: 0 0 0.5rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--articles-muted);
  }
  .articles__title {
    margin: 0;
    font-size: clamp(1rem, 0.85rem + 1.3vw, 1.45rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.35;
  }
  /* US-1706 precedent: the shared '> ' h3 prompt prefix is suppressed here —
     the editorial row is set typographically, not as a terminal line (CSS
     alt-'' content, so nothing about the a11y tree or the census moves). */
  .articles__title::before {
    content: none;
  }
  /* The title is the link; no resting underline (the row is one link in a list
     of links — a nav-menu-class context, not a link embedded in prose — and
     interaction is signalled by the ring/flip/shift, never colour alone). Its
     ::after stretches the hit target over the WHOLE row: the pseudo's
     containing block is the ROW (position:relative above), which is never an
     alien-decode host (all its text lives in nested blocks), so the decode
     pin's overflow:hidden on the h3 cannot clip the hit area (US-1202/US-1705
     — an abs-pos box whose containing block sits above the clipper escapes
     it). Colour flips are instant on both motion paths (US-604 idiom). */
  .articles__link {
    color: var(--mx-green);
    text-decoration: none;
    overflow-wrap: break-word;
  }
  .articles__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .articles__row:hover .articles__link,
  .articles__row:has(.articles__link:focus-visible) .articles__link {
    color: var(--mx-green-hi);
  }
  /* The hover-shift target. It must NOT be a transform on any ancestor of the
     stretched ::after (a transformed ancestor becomes its containing block and
     collapses the row-wide hit area mid-hover), and it must NOT be an
     inline-block atom (a wrapped multi-line atom is a full-width rectangle, so
     the ↗ after it drops to an orphan line instead of hugging the last word).
     So: a plain INLINE span shifted via position:relative + left — relpos
     applies to inline boxes, offsets paint without reflow, and the span is the
     pseudo's SIBLING, never its containing block. The span stays inline ⇒ the
     alien-decode host is still the h3, exactly the shipped grouping. */
  .articles__title-text {
    position: relative;
    left: 0;
    overflow-wrap: break-word;
  }
  /* External-link cue (decoration only — aria-hidden, so the link's accessible
     name stays just the article title), integrated small and muted. */
  .articles__ext {
    display: inline-block;
    margin-left: 0.4em;
    font-size: 0.72em;
    color: var(--articles-muted);
  }
  .articles__row:hover .articles__ext,
  .articles__row:has(.articles__link:focus-visible) .articles__ext {
    color: var(--mx-green-hi);
  }
  /* ONE clear keyboard ring around the whole row (the stretched link's own
     inline box would ring just the title text). The link's inner ring is
     suppressed ONLY where :has support makes the row ring real — belt and
     braces: no double ring, and never an invisible focus. */
  .articles__row:has(.articles__link:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: -3px;
  }
  @supports selector(li:has(a)) {
    .articles__link:focus-visible {
      outline: none;
    }
  }
  /* Publication + date: the US-1704 single-source meta (language-agnostic
     identifier + the build-time Intl date), now an inline editorial run parted
     by a decorative middot (CSS alt-'' content — never in the a11y tree; it
     rides the host's inline flow like the '> ' h3 prefix, so the decode pin
     geometry already includes it). */
  .articles__meta {
    list-style: none;
    margin: 0.55rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    font-size: clamp(0.72rem, 1.3vw, 0.8rem);
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--articles-muted);
  }
  .articles__meta li + li::before {
    content: '·' / '';
    margin-inline: 0.6em;
    color: var(--mx-green-dim);
  }
  /* The optional dek (schema `description`, absent in seed data — P3). Start-
     aligned like the rest of the row (the .articles justify exemption), so no
     per-element measure cap is needed (US-702 binds justified prose). */
  .articles__desc {
    margin: 0.7rem 0 0;
    font-size: clamp(0.78rem, 1.4vw, 0.88rem);
    line-height: 1.6;
    color: var(--articles-muted);
    overflow-wrap: break-word;
  }
  /* Movement rides ONLY under full motion (the US-604 hover-lift rule): the
     title steps 3px right (relpos left — paint-only, reflow-free, see above),
     the arrow steps diagonally (transform — it IS an inline-block atom, one
     glyph, so it never wraps internally); under data-motion='reduced' the
     hover cue is purely the instant colour flips above. Neither span is a
     [data-reveal] target, so nothing here can fight the reveal transition
     (US-1716). */
  :global(html[data-motion='full']) .articles__title-text {
    transition: left 180ms ease;
  }
  :global(html[data-motion='full']) .articles__ext {
    transition: transform 180ms ease, color 180ms ease;
  }
  :global(html[data-motion='full']) .articles__no {
    transition: color 180ms ease, opacity 180ms ease;
  }
  :global(html[data-motion='full']) .articles__link {
    transition: color 180ms ease;
  }
  :global(html[data-motion='full']) .articles__row + .articles__row {
    transition: border-top-color 180ms ease;
  }
  :global(html[data-motion='full']) .articles__row:hover .articles__title-text,
  :global(html[data-motion='full']) .articles__row:has(.articles__link:focus-visible) .articles__title-text {
    left: 3px;
  }
  :global(html[data-motion='full']) .articles__row:hover .articles__ext,
  :global(html[data-motion='full']) .articles__row:has(.articles__link:focus-visible) .articles__ext {
    transform: translate(2px, -2px);
  }
  /* Narrow ladder: below 36rem the numeral leaves the side lane and sits small
     above the content — one full-width column, long titles wrap naturally, no
     fixed heights anywhere (the reference's mobile brief). */
  @media (max-width: 36rem) {
    .articles__row {
      display: block;
    }
    .articles__no {
      display: block;
      font-size: 2rem;
      line-height: 1;
      margin-bottom: 0.55rem;
    }
  }

  /* --- Interests ("03 — Banda Compacta", 2026-08-09 — SUPERSEDES the
     2026-08-08 "07 — Echo Trails" meteor lanes; data still US-023). The owner
     brief: keep the ONE continuous horizontal band with five equivalent
     stations, but make it perceptibly SHORTER and quieter — short connectors,
     precise alignment, subtle column separators, a cleaner label zone. So: a
     shared violet RAIL near the panel top (::before on the <ul>, ABSOLUTE —
     an in-flow pseudo of a grid container becomes a grid ITEM, the US-1705
     trap), one short dashed DROP GUIDE per station meeting the rail at a
     bright tick, icons on one shared visual baseline, labels on a second,
     and 1px separators at each column gap, inset from the panel edges
     (never five cards — the stations carry no fill, border or box).

     GEOMETRY CONTRACT (what keeps every alignment true by construction): at
     the 5-column tier the panel's top padding EQUALS --band-rail-y, so row
     1's content top sits exactly on the rail line; the drop guide is an
     IN-FLOW pseudo of fixed --band-drop-h starting at that top ⇒ it touches
     the rail with zero magic offsets and ends a flex-gap ABOVE the icon
     (guides never enter the glyph), and every station shares identical
     structure above the label ⇒ icons and labels each share a baseline.
     Below 56rem the single rail no longer represents the stacked layout, so
     rail + guides + ticks hide together (the brief sanctions this) and the
     top padding relaxes.

     COLUMN TIERS in EXCLUSIVE ranges (each tier owns its placement rules,
     nothing leaks across a boundary): <40rem → 2 columns; 40–55.99rem → 3
     columns drawn on SIX half-tracks so the 2-station last row can CENTER
     without touching DOM order (every station spans 2 tracks; the
     quantity-guarded :nth-child(4):nth-last-child(2) — it matches only when
     exactly 5 items exist — starts row 2 at track 2, and the 5th auto-flows
     beside it); ≥56rem → 5 columns. Separators suppress at each row start
     with the matching rows-of-N formula (2n+1 / 3n+1 / 5n+1), so a 6th
     interest self-flows with ZERO new CSS (the Echo Trails scalability
     contract, kept).

     COMPACTION is padding/gap/proportion only — no fixed heights, no
     viewport-dependent values, nothing truncated (labels wrap freely inside
     their minmax(0,1fr) tracks and the band grows with them). Echo Trails
     measured 276.4px @1280 / 481.3px @360; the exact compact pins live in
     scripts/ralph/artifacts/interests-banda-compacta/RESULTS.md.

     QUIET LABEL STRIP: the --crt-lines-note scanline layer STOPS
     --band-quiet-h above the panel bottom (background-size clip on the
     no-repeat layer), so the label zone reads cleaner than the icon zone —
     same surface, no internal panel, no new gradient.

     STATIC BY DESIGN: the float/jitter/echo/stream loops retired WITH the
     meteors — the section ships ZERO animations on BOTH motion paths (the
     brief asks for less noise; the page-wide full-motion running-infinite
     census drops to 4 names: blink, crt-flicker, pipe-pulse,
     contact-electric). The only glow is the static rail/tick halo + head
     drop-shadow, so §15 has nothing left to rate here. P6/P7: --note-*
     tokens only; --note-head labels ≥4.5:1 composited over black worst
     case; rail/guides/separators are non-text decoration (recorded, not
     gated — the US-1705 rule). US-026 still owns the reveal. --- */
  .interests {
    /* The shared knobs — the whole composition tunes from these (the
       brief's "propiedades CSS compartidas"; no per-element coordinates). */
    --band-rail-y: 1.35rem; /* rail offset from the panel's inner top */
    --band-drop-h: 1.5rem; /* dashed guide length: rail → icon zone */
    --band-icon: 2.1rem; /* head font-size ⇒ ~2.5rem glyph (1.2em svg) */
    --band-gap: 1.4rem; /* column gap; separators sit at its midpoint */
    --band-pad-x: 1.6rem;
    --band-pad-top: 1.05rem; /* stacked tiers; ≥56rem takes --band-rail-y */
    --band-pad-bottom: 1rem;
    --band-quiet-h: 2.9rem; /* scanline-free strip behind the labels */
    --band-line: color-mix(in srgb, var(--note-accent) 62%, transparent);
    --band-tick: color-mix(in srgb, var(--note-accent) 90%, transparent);
    --band-sep: color-mix(in srgb, var(--note-accent) 16%, transparent);
    --band-glow: color-mix(in srgb, var(--note-accent) 30%, transparent);
    list-style: none;
    margin: 0;
    position: relative;
    padding: var(--band-pad-top) var(--band-pad-x) var(--band-pad-bottom);
    background-color: var(--surface-panel);
    background-image: var(--crt-lines-note);
    background-repeat: no-repeat;
    background-size: 100% calc(100% - var(--band-quiet-h));
    border: 1px solid color-mix(in srgb, var(--note-accent) 45%, transparent);
    border-radius: 4px;
    box-shadow: 0 2px 22px color-mix(in srgb, var(--note-accent) 14%, transparent);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem var(--band-gap);
  }
  /* Borderless stations — a station reads through its icon + label alone
     (no per-item box, no fill: the brief's "never five cards").
     position:relative hosts the separator pseudo; the flex column centers
     the drop zone over the label, and the grid row's default stretch keeps
     sibling stations the same height, so the icon and label baselines hold
     across a row by construction. */
  .interests__station {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  /* Column separator — a 1px hairline at the midpoint of the column gap,
     inset below the row top (so it clears the rail) and overshooting the
     row bottom by LESS than the bottom padding, so it always ends inside
     the panel with a margin (the brief's containment). Absolute ⇒ zero
     layout contribution; it rides the station's stretched row height, so a
     wrapped label lengthens it with its row. Row starts suppress it per
     tier below (rows-of-N formulas). */
  .interests__station::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(var(--band-gap) / -2 - 0.5px);
    inset-block: 0.35rem -0.45rem;
    inline-size: 1px;
    background: var(--band-sep);
    pointer-events: none;
  }
  /* The decorative drop zone (aria-hidden as a whole, pointer-events:none —
     guide, tick, arcs and icon never reach AT or the pointer): a flex
     column whose gap is the guide→icon clearance, so the dashed guide can
     never end inside the glyph. Its ::before/::after (guide + rail tick)
     exist only at the 5-column tier — see the ≥56rem block below. */
  .interests__drop {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    pointer-events: none;
  }
  /* The station head — the Icon wrapper. The glyph is sized ENTIRELY by
     this wrapper's font-size: Icon.astro's svg is a scoped `1.2em`, so
     --band-icon 2.1rem renders a ~2.5rem mark (the US-023 child-cid
     boundary — never reach across it to restyle the svg). ONE fixed size at
     every width (the brief: no arbitrary per-station or per-width scale
     changes — recognizable everywhere, dominating nowhere). `color` is
     --note-accent, so the Icon's currentColor stroke renders violet; the
     drop-shadow is the head's static halo (nothing animates a filter). */
  .interests__head {
    position: relative;
    display: inline-flex;
    font-size: var(--band-icon);
    line-height: 1;
    color: var(--note-accent);
    filter: drop-shadow(0 0 7px color-mix(in srgb, var(--note-accent) 55%, transparent));
  }
  /* Arc side-marks (the reference's small arcs beside each head — kept from
     Echo Trails, now perfectly still): two curved hairlines, pseudo-only —
     no DOM, invisible to AT under the aria-hidden drop zone. Pure
     decoration on their own layer, no layout contribution. */
  .interests__head::before,
  .interests__head::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inline-size: 0.4em;
    block-size: 0.9em;
    border: 0 solid color-mix(in srgb, var(--note-accent) 55%, transparent);
    opacity: 0.8;
  }
  .interests__head::before {
    inset-inline-start: -0.55em;
    border-inline-start-width: 1px;
    border-radius: 50%;
    transform: translateY(-50%);
  }
  .interests__head::after {
    inset-inline-end: -0.55em;
    border-inline-end-width: 1px;
    border-radius: 50%;
    transform: translateY(-50%);
  }
  /* The label line — the accessible content: real text, one per station,
     centered under its icon on the shared second baseline. ONE fixed
     readable size at every width (the brief bans diminutive text — the old
     0.72rem mobile floor rises to 0.8rem), gently tracked, free to wrap:
     never truncated, no ellipsis, no clipping anywhere. */
  .interests__label {
    display: block;
    min-width: 0;
    /* border-box is load-bearing WITH the max-width: there is no global
       box-sizing reset in this codebase, and as a CENTERED flex item the
       label's fit-content width is driven by min-content — which an
       unbroken long token keeps at full token width (overflow-wrap does
       not shrink min-content, the US-1706 lesson) — so max-width:100% is
       what caps it to the station… and on the default content-box that
       cap EXCLUDES the inline padding, overflowing the station by exactly
       that padding under long-token stress (probed: label 129.4px in a
       118.2px station @360). */
    box-sizing: border-box;
    max-width: 100%;
    padding-inline: 0.35rem;
    text-align: center;
    color: var(--note-head);
    font-size: 0.8rem;
    letter-spacing: 0.07em;
    line-height: 1.4;
    /* Break a long label cleanly so a station never forces h-scroll. */
    overflow-wrap: break-word;
  }

  /* --- Column tiers, EXCLUSIVE ranges (see the block comment above). --- */
  /* <40rem — 2 columns (mobile). A lone 5th station takes the whole last
     row and centers via its own flex centering — quantity-guarded (5th AND
     last), so any other item count just auto-flows. */
  @media (max-width: 39.99rem) {
    .interests__station:nth-child(5):nth-last-child(1) {
      grid-column: 1 / -1;
    }
    .interests__station:nth-child(2n + 1)::before {
      content: none;
    }
  }
  /* 40–55.99rem — 3 columns on SIX half-tracks; the quantity-guarded rule
     starts the 4th station at track 2, so the 2-station last row centers
     (the 5th auto-flows into tracks 4–5 beside it; DOM order untouched). */
  @media (min-width: 40rem) and (max-width: 55.99rem) {
    .interests {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .interests__station {
      grid-column: span 2;
    }
    .interests__station:nth-child(4):nth-last-child(2) {
      grid-column: 2 / span 2;
    }
    .interests__station:nth-child(3n + 1)::before {
      content: none;
    }
  }
  /* ≥56rem — the full band: 5 equal columns in one row, rail + guides +
     ticks on, and the top padding BECOMES the rail offset (the geometry
     contract: row 1's content top = the rail line, so the in-flow guides
     meet it with zero magic numbers). */
  @media (min-width: 56rem) {
    .interests {
      --band-pad-top: var(--band-rail-y);
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .interests__station:nth-child(5n + 1)::before {
      content: none;
    }
    /* The shared rail — 1px across the content width (inset by the panel's
       own inline padding), faint static halo. ABSOLUTE: an in-flow pseudo
       of a grid container becomes a grid ITEM (the US-1705 trap). */
    .interests::before {
      content: '';
      position: absolute;
      inset-inline: var(--band-pad-x);
      inset-block-start: var(--band-rail-y);
      block-size: 1px;
      background: var(--band-line);
      box-shadow: 0 0 9px var(--band-glow);
      pointer-events: none;
    }
    /* The dashed drop guide — IN-FLOW, fixed length, starting exactly on
       the rail (geometry contract) and ending a flex-gap above the icon
       (guides never enter the glyph). Dash pattern via repeating-gradient
       (the Echo Trails idiom — a dashed border's pattern is not tunable). */
    .interests__drop::before {
      content: '';
      inline-size: 2px;
      block-size: var(--band-drop-h);
      background: repeating-linear-gradient(
        to bottom,
        var(--band-line) 0,
        var(--band-line) 0.32rem,
        transparent 0.32rem,
        transparent 0.62rem
      );
    }
    /* The rail tick — a short bright nub crossing the rail at each
       junction (the reference's geometric terminals; kin to the site's
       phosphor node dots). The drop zone's top IS the rail line, so
       translate(-50%,-50%) centers it on the rail exactly. */
    .interests__drop::after {
      content: '';
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 50%;
      inline-size: 2px;
      block-size: 0.45rem;
      transform: translate(-50%, -50%);
      background: var(--band-tick);
      box-shadow: 0 0 6px var(--band-glow);
    }
  }

  /* --- Contact — FREQUENCY BANDS (2026-08-09; the "05" concept — supersedes
     the US-024/US-709 icon-only row, the US-1610 open band + icon marquee and
     the US-1715 triple-scale geometry). The marquee module pair
     src/components/contact/{marquee-loader,marquee}.ts is DELETED with the
     ?marquee=tune debug surface and the --marquee-band-h /
     --contact-chip-size / --cmq-gap knobs; every node here is SSR (scoped cid
     everywhere — no :global needed, no runtime-element boundary left).

     THE LIST: ul.contact > li.contact__band > a.contact__band-link — ONE real
     anchor per route and the WHOLE band is the target (no nested controls;
     the arrow is aria-hidden paint, never a second link). Grid tracks are
     CONTENT-INDEPENDENT (fixed rem + minmax(0,1fr), the pipeline-matrix rule)
     so the five columns align across bands by construction; the name/handle
     tracks are minmax(0,…) + overflow-wrap:anywhere so an unbroken long
     handle WRAPS inside its track instead of growing it (the US-1706
     min-content lesson). Heights are content-driven — min-block-size is a
     tap-target floor (≫44px, WCAG 2.5.8), never a fixed height, so zoom /
     translations / long handles just grow the band.

     P6 (the US-1607 "P6 decides the surface" rule): each band carries its own
     --surface-code face (94% void) + darken-only --crt-lines-note texture, so
     over the brightest live rain head the name (--note-head) reads ≈17:1 and
     handle / index / icon / arrow (--note-accent) ≈5.8:1 (≥4.5:1 text, ≥3:1
     non-text). Border = the 45%-accent mix the note panels carry (US-708
     seating); --note-* tokens only (P7).

     INTERACTION: hover lives behind @media (hover:hover) (coarse pointers
     never depend on it) and is an INSTANT state on both motion paths — border
     to full accent, a subtle violet face tint, the left corner brackets, a
     controlled halo; ONLY the eases + the small arrow slide ride
     html[data-motion='full'] (the US-604 idiom — under 'reduced' the cue is
     the colour flip alone, zero displacement). :focus-visible mirrors the
     same emphasis PLUS the ring (--focus-ring re-registered to --note-accent
     DOM-scoped on the list, the .aero precedent — never [data-theme]-keyed).
     Nothing here animates continuously; the section's only infinite motion
     stays the US-1716 title shimmer. --- */
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    --focus-ring: var(--note-accent);
  }
  .contact__band-link {
    position: relative;
    display: grid;
    grid-template-columns: 2.7rem 3.4rem minmax(0, 1.15fr) minmax(0, 1fr) 2.4rem;
    grid-template-areas: 'idx icon name handle arrow';
    align-items: center;
    column-gap: clamp(0.6rem, 2vw, 1.3rem);
    min-block-size: 4.6rem;
    padding: 0.9rem clamp(0.9rem, 2.5vw, 1.5rem);
    background-image: var(--crt-lines-note);
    background-color: var(--surface-code);
    border: 1px solid color-mix(in srgb, var(--note-accent) 45%, transparent);
    border-radius: 6px;
    color: var(--note-head);
    text-decoration: none;
  }
  /* Left corner brackets — the mock's emphasis detail. One pseudo, four
     no-repeat strokes floating 4px outside the band's left edge (top-left +
     bottom-left L returns); absolutely positioned + pointer-events:none ⇒
     zero layout shift, and nothing in the section clips it (no overflow).
     Revealed by hover/:focus-visible as an instant opacity flip (both motion
     paths — the US-604 idiom). */
  .contact__band-link::before {
    content: '';
    position: absolute;
    inset: -4px auto -4px -4px;
    width: 0.85rem;
    pointer-events: none;
    opacity: 0;
    background:
      linear-gradient(var(--note-accent), var(--note-accent)) left top / 100% 1px,
      linear-gradient(var(--note-accent), var(--note-accent)) left top / 1px 11px,
      linear-gradient(var(--note-accent), var(--note-accent)) left bottom / 100% 1px,
      linear-gradient(var(--note-accent), var(--note-accent)) left bottom / 1px 11px;
    background-repeat: no-repeat;
  }
  .contact__band-index {
    grid-area: idx;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--note-accent);
  }
  .contact__band-icon {
    grid-area: icon;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Icon.astro's svg is width:1.2em — size it via font-size across the
       US-023 child-cid boundary, never a cross-boundary selector. */
    font-size: 1.55rem;
    line-height: 1;
    color: var(--note-accent);
  }
  .contact__band-name {
    grid-area: name;
    min-width: 0;
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: 0.02em;
    color: var(--note-head);
    overflow-wrap: anywhere;
  }
  .contact__band-handle {
    grid-area: handle;
    min-width: 0;
    font-size: 0.92rem;
    color: var(--note-accent);
    overflow-wrap: anywhere;
  }
  .contact__band-arrow {
    grid-area: arrow;
    justify-self: end;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--note-accent);
  }
  /* Hover — capability-gated so touch never depends on it (the band itself is
     always the tap target); instant state flips on both motion paths. */
  @media (hover: hover) {
    .contact__band-link:hover {
      border-color: var(--note-accent);
      background-color: color-mix(in srgb, var(--note-accent) 8%, var(--surface-code));
      box-shadow: 0 0 18px color-mix(in srgb, var(--note-accent) 18%, transparent);
    }
    .contact__band-link:hover::before {
      opacity: 1;
    }
  }
  /* :focus-visible — the same emphasis as hover PLUS the ring (the theme.css
     catch-all recipe restated with a local offset; the outline is never
     removed without this replacement, and nothing clips it). */
  .contact__band-link:focus-visible {
    border-color: var(--note-accent);
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
  .contact__band-link:focus-visible::before {
    opacity: 1;
  }
  /* Motion layer — eases + the arrow's small slide ride the resolved FULL
     preference only (data-motion, never the OS query): under 'reduced' there
     is no displacement at all, the hover/focus cue is purely the instant
     colour/border flip above. */
  :global(html[data-motion='full']) .contact__band-link {
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }
  :global(html[data-motion='full']) .contact__band-arrow {
    transition: transform 180ms ease;
  }
  @media (hover: hover) {
    :global(html[data-motion='full']) .contact__band-link:hover .contact__band-arrow {
      transform: translateX(0.3rem);
    }
  }
  :global(html[data-motion='full']) .contact__band-link:focus-visible .contact__band-arrow {
    transform: translateX(0.3rem);
  }
  /* ≤48rem — the five-column row gives way to the stacked fallback (the SAME
     DOM at every width): index + icon flank a two-row text block (name over
     handle), arrow at the end; idx/icon/arrow span both rows. 47.99 keeps the
     bound EXCLUSIVE (the 51.99 house idiom) — a 768px/48rem tablet still has
     comfortable room for the five columns, so it keeps the desktop grid. */
  @media (max-width: 47.99rem) {
    .contact__band-link {
      grid-template-columns: 2rem 2.5rem minmax(0, 1fr) 1.9rem;
      grid-template-areas:
        'idx icon name arrow'
        'idx icon handle arrow';
      row-gap: 0.2rem;
      min-block-size: 4.2rem;
      padding-block: 0.8rem;
    }
    .contact__band-name {
      align-self: end;
    }
    .contact__band-handle {
      align-self: start;
    }
  }
  /* --- US-1716 — the CONTACT title: electric violet (owner: "estetica del
     titulo contact diferente a toda la pagina"; OD-5 = AGGRESSIVE violet, the
     aggression living in glow amplitude/saturation/spread, NEVER in flash
     rate). 2026-08-09 Frequency Bands: the full-width divider beam is
     REPLACED by the mock's two short CIRCUIT ORNAMENTS flanking the title —
     each a line fading in from the outside and terminating in a node dot
     against the plate — and the title sets uppercase with a viewport-clamped
     size (at the old fixed 1.75rem, CONTACTO + two ornaments could not share
     360px).

     THE CID BOUNDARY (AC5): `.section__inner` / `.section__title` /
     `.section__body` belong to Section.astro, so they carry ITS cid and a
     scoped rule here could never match them (the US-023 child-component
     boundary). Every selector below is therefore wrapped WHOLE in `:global(…)`
     — `:global(a) b` would still cid-qualify `b`, so the closing paren goes
     after the LAST compound, pseudo-elements included. `#contact …` is
     (1,1,0), which beats the (0,5,0) note-register rule in Section.astro
     without !important.

     THE ORNAMENTS, without magic numbers: `.section__inner` is a 2-row grid
     whose first row is `1fr auto 1fr` — the h2 sits in the auto centre track
     and the ornaments are the inner's own ::before/::after pinned to the
     flanking 1fr tracks (justify-self end/start + align-self center), so they
     hug the plate at any font-size, locale or wrap count, and they shrink
     with the viewport because their width is a vw clamp (the "acortá los
     ornamentos" tablet/mobile requirement is the clamp, not a breakpoint).
     They are content:'' pseudos — no DOM, nothing in the a11y tree (US-1705),
     static on BOTH motion paths. The body row spans all three tracks.

     P6 / the US-029 theme-stable-surface rule: the bright core sits on the
     SAME dark void plate as every other tab (densified 96% so nothing reads
     through), so contrast is surface-internal — --note-head #EDE6FF over the
     plate composited over the brightest rain head reads ≈15.8:1, and NOTHING
     that animates can move it (see below).

     FLASH SAFETY (§15 / WCAG 2.3.1): the shimmer animates ONLY the two shadow
     stacks — `color` and `background` are constant, so the contrast floor is
     frame-independent by construction. One gentle glow swell per 5.5s ≈ 0.18
     luminance events/s ≪ 3/s, the change is a halo alpha (no colour
     inversion, no black frame), and it is gated on html[data-motion='full'] —
     the calm path shows the same static aggressive violet with zero running
     animations (the US-045 probe). It must NOT touch opacity/transform: those
     are the [data-reveal] transition's properties and an animation beats a
     transition on the same property (the US-604 rule). --- */
  :global(#contact .section__inner) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: clamp(0.6rem, 2vw, 1.1rem);
  }
  /* The two circuit ornaments. Line + node dot are background layers (the dot
     a radial-gradient hard stop at the inner end, the line fading in from the
     outer end); the soft glow is a STATIC drop-shadow filter — it follows the
     painted pixels, unlike a box-shadow on the 7px-tall box. --note-* only
     (P7); decorative, so contrast is recorded-not-gated (US-1705). */
  :global(#contact .section__inner::before),
  :global(#contact .section__inner::after) {
    content: '';
    align-self: center;
    width: clamp(1.6rem, 7vw, 6.5rem);
    height: 7px;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--note-accent) 50%, transparent));
  }
  :global(#contact .section__inner::before) {
    grid-area: 1 / 1;
    justify-self: end;
    background:
      radial-gradient(circle at calc(100% - 3px) 50%, var(--note-accent) 0 2.2px, transparent 2.9px),
      linear-gradient(
          90deg,
          transparent 0%,
          color-mix(in srgb, var(--note-mid) 80%, transparent) 45%,
          var(--note-accent) 100%
        )
        0 50% / 100% 1px;
    background-repeat: no-repeat;
  }
  :global(#contact .section__inner::after) {
    grid-area: 1 / 3;
    justify-self: start;
    background:
      radial-gradient(circle at 3px 50%, var(--note-accent) 0 2.2px, transparent 2.9px),
      linear-gradient(
          90deg,
          var(--note-accent) 0%,
          color-mix(in srgb, var(--note-mid) 80%, transparent) 55%,
          transparent 100%
        )
        0 50% / 100% 1px;
    background-repeat: no-repeat;
  }
  :global(#contact .section__title) {
    grid-area: 1 / 2;
    /* The bright CORE — full --note-head, not the US-1002 92% dim: this title
       is the page's one deliberate exception (the dim exists to make the tabs
       recede; this one must not). Uppercase + the wide tracking are the
       mock's display treatment — tracking stays title-only, per the brief. */
    color: var(--note-head);
    text-transform: uppercase;
    font-size: clamp(1.15rem, 0.65rem + 2.6vw, 1.75rem);
    letter-spacing: 0.16em;
    padding: 0.55rem 1.6rem 0.7rem;
    background:
      var(--crt-lines-note),
      color-mix(in srgb, var(--note-void) 96%, transparent);
    border-color: var(--note-accent);
    /* Multi-layer neon: a tight white-violet core bleed, then three widening
       accent halos. Rest state = the dim end of the shimmer. */
    text-shadow:
      0 0 4px color-mix(in srgb, var(--note-accent) 85%, transparent),
      0 0 12px color-mix(in srgb, var(--note-accent) 60%, transparent),
      0 0 26px color-mix(in srgb, var(--note-accent) 40%, transparent),
      0 0 52px color-mix(in srgb, var(--note-mid) 30%, transparent);
    box-shadow:
      0 0 16px color-mix(in srgb, var(--note-accent) 34%, transparent),
      0 0 44px color-mix(in srgb, var(--note-accent) 16%, transparent),
      inset 0 0 20px color-mix(in srgb, var(--note-mid) 18%, transparent);
  }
  :global(#contact .section__body) {
    grid-area: 2 / 1 / 3 / -1;
  }
  :global(html[data-motion='full'] #contact .section__title) {
    animation: contact-electric 5.5s ease-in-out infinite;
  }
  /* Astro does NOT hash @keyframes names in a scoped block, so this name is
     effectively global — hence the section prefix (US-1713). */
  @keyframes contact-electric {
    0%,
    100% {
      text-shadow:
        0 0 4px color-mix(in srgb, var(--note-accent) 85%, transparent),
        0 0 12px color-mix(in srgb, var(--note-accent) 60%, transparent),
        0 0 26px color-mix(in srgb, var(--note-accent) 40%, transparent),
        0 0 52px color-mix(in srgb, var(--note-mid) 30%, transparent);
      box-shadow:
        0 0 16px color-mix(in srgb, var(--note-accent) 34%, transparent),
        0 0 44px color-mix(in srgb, var(--note-accent) 16%, transparent),
        inset 0 0 20px color-mix(in srgb, var(--note-mid) 18%, transparent);
    }
    50% {
      text-shadow:
        0 0 6px color-mix(in srgb, var(--note-accent) 100%, transparent),
        0 0 18px color-mix(in srgb, var(--note-accent) 80%, transparent),
        0 0 38px color-mix(in srgb, var(--note-accent) 58%, transparent),
        0 0 74px color-mix(in srgb, var(--note-mid) 44%, transparent);
      box-shadow:
        0 0 24px color-mix(in srgb, var(--note-accent) 50%, transparent),
        0 0 62px color-mix(in srgb, var(--note-accent) 26%, transparent),
        inset 0 0 26px color-mix(in srgb, var(--note-mid) 26%, transparent);
    }
  }

  /* --- Research (US-025 shell): a brief lead-in (chrome prose, the chapter
     count derived from the data) over the empty chapter-list container US-031
     fills with the 6 chapters. Same ~90%-void panel as the other sections so
     text stays ≥4.5:1 over the live rain (P6); palette tokens only (P7). No
     motion here; US-026 owns the reveal. --- */
  .research {
    position: relative;
    background: var(--crt-lines-matrix), var(--surface-panel);
    /* "Protocolo Vivo" frame (2026-08-09): the continuous hairline steps a
       touch above the house --mx-green-far so the corner brackets + signal
       marks below read as ONE technical frame, not stray ticks. */
    border: 1px solid color-mix(in srgb, var(--mx-green-dim) 45%, var(--mx-green-far));
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
  }
  /* Protocolo Vivo — corner brackets: 8 no-repeat gradient layers (an L per
     corner) riding the panel border on an inset:-1px overlay. Pure paint on a
     pointer-events:none pseudo: no DOM, nothing in the a11y tree, and the
     panel padding (≥1rem at every width) keeps every mark clear of text. */
  .research::before {
    content: '';
    position: absolute;
    inset: -1px;
    pointer-events: none;
    border-radius: 4px;
    background:
      linear-gradient(var(--mx-green-dim), var(--mx-green-dim)) 0 0 / 1.1rem 2px,
      linear-gradient(var(--mx-green-dim), var(--mx-green-dim)) 0 0 / 2px 1.1rem,
      linear-gradient(var(--mx-green-dim), var(--mx-green-dim)) 100% 0 / 1.1rem 2px,
      linear-gradient(var(--mx-green-dim), var(--mx-green-dim)) 100% 0 / 2px 1.1rem,
      linear-gradient(var(--mx-green-dim), var(--mx-green-dim)) 0 100% / 1.1rem 2px,
      linear-gradient(var(--mx-green-dim), var(--mx-green-dim)) 0 100% / 2px 1.1rem,
      linear-gradient(var(--mx-green-dim), var(--mx-green-dim)) 100% 100% / 1.1rem 2px,
      linear-gradient(var(--mx-green-dim), var(--mx-green-dim)) 100% 100% / 2px 1.1rem;
    background-repeat: no-repeat;
  }
  /* Protocolo Vivo — signal marks on the top/bottom frame edges: dash groups
     flanking the seated title tab (the tab is centered, so the 2rem-inset
     groups can never collide with it), double-line ticks near the bottom
     corners, and a segmented bar at bottom center. Static paint, ramp tokens
     only; hidden ≤48rem (ambient effects recede on small screens). */
  .research::after {
    content: '';
    position: absolute;
    inset: -1px;
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, var(--mx-green-dim) 0 0.5rem, transparent 0.5rem 0.9rem)
        left 2rem top 0 / 3.7rem 2px,
      repeating-linear-gradient(90deg, var(--mx-green-dim) 0 0.5rem, transparent 0.5rem 0.9rem)
        right 2rem top 0 / 3.7rem 2px,
      linear-gradient(180deg, var(--mx-green-dim) 0 1px, transparent 1px 2px, var(--mx-green-dim) 2px 3px)
        left 2rem bottom 0 / 2.4rem 3px,
      linear-gradient(180deg, var(--mx-green-dim) 0 1px, transparent 1px 2px, var(--mx-green-dim) 2px 3px)
        right 2rem bottom 0 / 2.4rem 3px,
      repeating-linear-gradient(90deg, var(--mx-green-mid) 0 0.65rem, transparent 0.65rem 0.95rem)
        center bottom / 6.35rem 3px;
    background-repeat: no-repeat;
  }
  /* The lead (US-1702 copy, verbatim) — the 2026-08-08 editorial pass removed
     the `$ cat research/README.md` --surface-code band: the paragraph sits
     OPEN on the panel between the lab-status banner and the console grid, in
     the same muted register as the Articles rows (green-mid alone reads
     ≈4.5:1 "thin" on the bare 80% panel — the theme.css doctrine — so it
     mixes toward green-hi, ≈6.6:1 in situ over the brightest rain head, P6).
     Ragged-start like the articles editorial (exempted from the US-603
     justify in the shared group above); still a normal matrix-register
     alien-decode host. No card, no fill — the console band below carries its
     own border, so no extra rule here (a dashed hairline against the .pipe
     border would read as a double line). */
  .research__lead {
    margin: 0.8rem 0 0;
    color: color-mix(in srgb, var(--mx-green-mid) 55%, var(--mx-green-hi));
    font-size: clamp(0.82rem, 1.5vw, 0.92rem);
    line-height: 1.7;
  }
  /* ===== "07 / RESEARCH PIPELINE" (2026-08-08) — the offensive-security lab
     console. The collapsible chapter cards are gone; the section is a pipeline
     MATRIX. The header + every row share IDENTICAL, content-INDEPENDENT grid
     tracks (clamp / fr / clamp), so the three macro columns (id+title | 5 stages
     | status) align across every row WITHOUT subgrid or absolute positioning;
     the stages sit in a repeat(5, 1fr) sub-grid so the nodes align under the
     header labels. The console sits on --surface-code (94% void) so every token
     stays ≥4.5:1 over the live rain (P6); ramp tokens only (P7). ===== */

  /* Derived lab-status banner (aria-hidden decoration; the count comes from the
     pipeline data). First child of the panel since the 2026-08-08 editorial
     pass (the intro card above it is gone) — the panel padding is the gap. */
  .research__status {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55ch;
    color: var(--mx-green-mid);
    font-size: clamp(0.66rem, 1.2vw, 0.76rem);
    letter-spacing: 0.08em;
  }
  .research__status-val {
    padding: 0.05rem 0.45rem;
    background: var(--mx-green);
    color: var(--mx-void);
    border-radius: 2px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .research__status-sep {
    color: var(--mx-green-dim);
  }
  .research__status-count {
    color: var(--mx-green-hi);
    font-variant-numeric: tabular-nums;
  }

  /* The console band. */
  .pipe {
    margin: 1rem 0 0;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--surface-code);
    border: 1px solid var(--mx-green-far);
    border-radius: 4px;
    font-variant-numeric: tabular-nums;
  }

  /* Macro column template — IDENTICAL on the header + every row, so the three
     columns align without subgrid. Tracks are content-INDEPENDENT (clamp / fr /
     clamp resolve the same per row regardless of the title or status length);
     min-width:0 inside lets long content wrap/clip instead of widening a track,
     so the title can take two lines but never invade the stages. */
  .pipe__head,
  .pipe__row {
    display: grid;
    grid-template-columns:
      clamp(8.5rem, 24vw, 15rem)
      minmax(0, 1fr)
      clamp(5.25rem, 14vw, 8.5rem);
    column-gap: clamp(0.6rem, 1.6vw, 1.1rem);
    align-items: center;
  }

  /* Column header — the visual guide over the node columns (aria-hidden).
     Protocolo Vivo definition: the closing rule brightens to --mx-green-dim
     and gains a second --mx-green-far hairline 3px below (an absolute ::after
     — never an in-flow pseudo, which would become a grid ITEM, the US-1705
     trap), so the header reads as the console's own double-ruled masthead. */
  .pipe__head {
    position: relative;
    padding-bottom: 0.7rem;
    margin-bottom: 0.15rem;
    border-bottom: 1px solid var(--mx-green-dim);
    color: var(--mx-green-mid);
    font-size: clamp(0.58rem, 1.05vw, 0.7rem);
    letter-spacing: 0.1em;
  }
  .pipe__head::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    border-top: 1px solid var(--mx-green-far);
  }
  .pipe__head-label {
    overflow-wrap: anywhere;
  }
  .pipe__head-status {
    text-align: right;
    overflow-wrap: anywhere;
  }

  /* The 5-stage sub-grid — shared by the header (icon + label) and every row
     (nodes). repeat(5, 1fr) with NO column-gap so each connector (width:100% of
     its gapless 1fr cell, from the node centre at left:50%) reaches EXACTLY the
     next node centre. */
  .pipe__stages {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    min-width: 0;
  }
  .pipe__stage-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    text-align: center;
  }
  .pipe__stage-icon {
    display: inline-flex;
    color: var(--mx-green-mid);
    font-size: 0.95rem;
    line-height: 1;
  }
  .pipe__stage-name {
    overflow-wrap: anywhere;
  }

  /* Rows — a semantic <ol> of investigations, parted by hairline rules (no card
     fills; the console band is the surface, matching the reference's open rows). */
  .pipe__rows {
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
  }
  .pipe__row {
    position: relative;
    padding: 0.85rem 0;
    border-top: 1px solid var(--mx-green-far);
  }
  .pipe__rows > .pipe__row:first-child {
    border-top: 0;
  }
  /* --- Foco Activo (2026-08-09, re-scoped to HOVER on the owner's call —
     "que sea al pasar el mouse por arriba… no algo estático"): every row
     lights its technical contour on pointer hover, in TWO registers —
     PUBLISHED rows take the green phosphor treatment (a live, readable
     investigation), every other status takes a grey/white treatment that
     reads LOCKED (the mint-white --mx-green-hi at low alpha IS the ramp's
     grey/white — no new hex, P7), reinforced by cursor:not-allowed. The
     whole treatment is an absolutely-positioned ::before OUTSET past the
     row box (inset 0.3rem -0.6rem, into the band's 1.1rem padding): zero
     layout impact, so the shared grid tracks — and the five node columns —
     stay aligned across every row by construction, and the alien-decode
     host pins are untouched. z-index:0 makes the row its own stacking
     context so the pseudo's z-index:-1 paints behind the row's content but
     above the band. Hover lives behind @media (hover:hover) (the Frequency
     Bands precedent — no sticky phantom state on touch); the appearance is
     an INSTANT flip on both motion paths (the US-604 idiom, P5 — nothing to
     gate). Keyboard stays ≥ hover: a row holding a real focused control
     (:focus-within — LAB-001's reader link) shows the same green contour
     with no pointer involved, and the link keeps its own :focus-visible
     ring. The row dividers sit outside the 0.3rem vertical inset. */
  .pipe__row:focus-within {
    z-index: 0;
  }
  .pipe__row:focus-within::before {
    content: '';
    position: absolute;
    inset: 0.3rem -0.6rem;
    z-index: -1;
    pointer-events: none;
    border: 2px solid color-mix(in srgb, var(--mx-green) 52%, var(--mx-green-far));
    border-radius: 2px;
    background: color-mix(in srgb, var(--mx-green) 7%, transparent);
  }
  @media (hover: hover) {
    .pipe__row:hover {
      z-index: 0;
    }
    /* Blocked register (the default): grey/white contour + corner brackets +
       a faint neutral tint — "locked, not yet readable". */
    .pipe__row:hover::before {
      --pv-bracket: color-mix(in srgb, var(--mx-green-hi) 62%, transparent);
      --pv-tint: color-mix(in srgb, var(--mx-green-hi) 5%, transparent);
      content: '';
      position: absolute;
      inset: 0.3rem -0.6rem;
      z-index: -1;
      pointer-events: none;
      border: 2px solid color-mix(in srgb, var(--mx-green-hi) 40%, transparent);
      border-radius: 2px;
      background:
        linear-gradient(var(--pv-bracket), var(--pv-bracket)) 0 0 / 0.65rem 2px,
        linear-gradient(var(--pv-bracket), var(--pv-bracket)) 0 0 / 2px 0.65rem,
        linear-gradient(var(--pv-bracket), var(--pv-bracket)) 100% 0 / 0.65rem 2px,
        linear-gradient(var(--pv-bracket), var(--pv-bracket)) 100% 0 / 2px 0.65rem,
        linear-gradient(var(--pv-bracket), var(--pv-bracket)) 0 100% / 0.65rem 2px,
        linear-gradient(var(--pv-bracket), var(--pv-bracket)) 0 100% / 2px 0.65rem,
        linear-gradient(var(--pv-bracket), var(--pv-bracket)) 100% 100% / 0.65rem 2px,
        linear-gradient(var(--pv-bracket), var(--pv-bracket)) 100% 100% / 2px 0.65rem,
        linear-gradient(var(--pv-tint), var(--pv-tint));
      background-repeat: no-repeat;
    }
    /* Published register: the green phosphor contour (the live one). */
    .pipe__row[data-status='published']:hover::before {
      --pv-bracket: var(--mx-green);
      --pv-tint: color-mix(in srgb, var(--mx-green) 7%, transparent);
      border-color: color-mix(in srgb, var(--mx-green) 52%, var(--mx-green-far));
    }
    /* Chevron marker in the left margin (the band padding hosts it), in the
       row's own register. */
    .pipe__row:hover::after {
      content: '';
      position: absolute;
      top: 50%;
      left: -1rem;
      width: 0.44rem;
      height: 0.44rem;
      border-top: 2px solid color-mix(in srgb, var(--mx-green-hi) 62%, transparent);
      border-right: 2px solid color-mix(in srgb, var(--mx-green-hi) 62%, transparent);
      transform: translateY(-50%) rotate(45deg);
      pointer-events: none;
    }
    .pipe__row[data-status='published']:hover::after {
      border-color: var(--mx-green);
    }
    /* The lock cue — a non-published row is not readable yet, and the cursor
       says so (the visible status text + hollow nodes carry the state too,
       never the cursor alone). */
    .pipe__row:not([data-status='published']):hover {
      cursor: not-allowed;
    }
  }

  /* Col 1 — id + title. */
  .pipe__meta {
    min-width: 0;
  }
  .pipe__id {
    display: block;
    color: var(--mx-green);
    font-size: clamp(0.68rem, 1.3vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .pipe__title {
    margin: 0.25rem 0 0;
    color: var(--mx-green-hi);
    font-size: clamp(0.9rem, 1.7vw, 1.02rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.4;
    overflow-wrap: break-word;
  }
  .pipe__link {
    color: inherit;
    text-decoration: none;
  }
  .pipe__link:hover {
    color: var(--mx-green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pipe__link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .pipe__ext {
    display: inline-block;
    margin-left: 0.3em;
    font-size: 0.8em;
  }
  /* Redacted title — a classified placeholder, set apart (dim + tracked +
     italic); still readable ≥4.5:1 (--mx-green-mid over the 94% console). */
  .pipe__title-text[data-redacted] {
    color: var(--mx-green-mid);
    font-style: italic;
    letter-spacing: 0.14em;
  }
  /* Tags — a compact dim metadata line under the title. Inline <li>s flow like
     text and wrap; a CSS ·-separator (alt '' ⇒ never announced) parts them, so
     no separator text node reaches the a11y tree. --mx-green-mid over the 94%
     console composite stays ≥4.5:1 (P6). */
  .pipe__tags {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }
  .pipe__tag {
    display: inline;
    color: var(--mx-green-mid);
    font-size: clamp(0.6rem, 1.15vw, 0.68rem);
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .pipe__tag:not(:last-child)::after {
    content: ' · ' / '';
    color: var(--mx-green-far);
  }
  /* Current-stage caption — a sighted MOBILE aid; hidden on the wide matrix
     where the aligned column header labels the nodes. */
  .pipe__stage-current {
    display: none;
    margin: 0.4rem 0 0;
    align-items: baseline;
    gap: 0.6ch;
    color: var(--mx-green-mid);
    font-size: clamp(0.66rem, 1.3vw, 0.74rem);
    letter-spacing: 0.05em;
  }
  .pipe__stage-current-idx {
    color: var(--mx-green-hi);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Col 2 — the 5 nodes + connectors. Each stage cell centres its node; a
     ::after connector reaches the NEXT node centre (width:100% of the gapless
     1fr cell from left:50%). SHAPE carries state — filled (done) / bright ring
     (current) / empty (pending) — and the connector solid (done) vs dashed
     (pending), so nothing depends on colour alone (WCAG 1.4.1). */
  .pipe__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 1.35rem;
    min-width: 0;
  }
  .pipe__stage::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    border-top: 1px dashed var(--mx-green-dim);
    transform: translateY(-50%);
    z-index: 0;
  }
  .pipe__stage:last-child::after {
    display: none;
  }
  .pipe__stage[data-state='done']::after {
    border-top-style: solid;
    border-top-color: var(--mx-green-mid);
  }
  .pipe__node {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    border: 1px solid var(--mx-green-dim);
    /* Empty (pending): the console bg fills the ring so the connector passes
       cleanly behind the node. */
    background: var(--surface-code);
  }
  .pipe__stage[data-state='done'] .pipe__node {
    background: var(--mx-green);
    border-color: var(--mx-green);
  }
  /* Current: a RING with a light centre (shape, not colour, separates it from
     the uniformly-filled done node and the hollow pending node). */
  .pipe__stage[data-state='current'] .pipe__node {
    width: 0.78rem;
    height: 0.78rem;
    background: var(--mx-green-hi);
    border: 2px solid var(--mx-green);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mx-green) 28%, transparent);
  }
  /* Foco Activo: the in-progress row's current node steps up — slightly
     larger, an INNER dark ring between the green ring and the light core, and
     a contained static halo (paint only; the pipe-pulse gate is untouched). */
  .pipe__row[data-status='in-progress'] .pipe__stage[data-state='current'] .pipe__node {
    width: 0.92rem;
    height: 0.92rem;
    box-shadow:
      inset 0 0 0 2px var(--mx-void),
      0 0 0 3px color-mix(in srgb, var(--mx-green) 45%, transparent),
      0 0 14px 2px color-mix(in srgb, var(--mx-green) 38%, transparent);
  }
  /* Discreet pulse on the CURRENT node — gated on full motion (P5). Flash-safe:
     one gentle ring expansion per 2.4s (≈0.4/s ≪ 3/s), transform + opacity only,
     no colour inversion, no black frame. Under data-motion='reduced' the current
     node rests on the static highlighted ring above. */
  :global(html[data-motion='full']) .pipe__stage[data-state='current'] .pipe__node::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--mx-green);
    animation: pipe-pulse 2.4s ease-out infinite;
  }
  @keyframes pipe-pulse {
    0% {
      transform: scale(0.7);
      opacity: 0.85;
    }
    70% {
      opacity: 0;
    }
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  /* Col 3 — status + date, right-aligned. Status intensity varies by state, but
     the LABEL TEXT (and the node fills) carry the state, so colour is never the
     sole cue; every token stays ≥4.5:1 over the console (P6). */
  .pipe__status {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.12rem;
    min-width: 0;
    text-align: right;
  }
  .pipe__status-label {
    font-size: clamp(0.64rem, 1.25vw, 0.76rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    overflow-wrap: anywhere;
  }
  .pipe__row[data-status='published'] .pipe__status-label {
    color: var(--mx-green-hi);
  }
  .pipe__row[data-status='validated'] .pipe__status-label {
    color: var(--mx-green);
  }
  /* Foco Activo: the active investigation's status steps UP from the muted
     mid register to the bright phosphor accent (≈14.7:1 on the void-based
     console — the nav-anchor pin), weight-reinforced; the contour/chevron
     geometry above carries the state alongside, never colour alone. */
  .pipe__row[data-status='in-progress'] .pipe__status-label {
    color: var(--mx-green);
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .pipe__row[data-status='upcoming'] .pipe__status-label {
    color: var(--mx-green-mid);
  }
  .pipe__date {
    color: var(--mx-green-mid);
    font-size: clamp(0.58rem, 1.05vw, 0.66rem);
    letter-spacing: 0.04em;
  }

  /* --- Mobile (≤ 48rem): the wide matrix would crush the five labelled columns,
     so each investigation becomes a stacked block — id + status on top, title
     below, then the node strip full-width, then the current-stage caption. No
     fixed heights; the node track stays a repeat(5,1fr) grid (the five small
     nodes fit 360px without scroll, so the page never scrolls horizontally — the
     "overflow-x only inside the pipeline" escape hatch isn't needed). --- */
  @media (max-width: 48rem) {
    .pipe__head {
      display: none;
    }
    .pipe__row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'meta   status'
        'stages stages';
      column-gap: 0.9rem;
      row-gap: 0.7rem;
      align-items: start;
      padding: 0.95rem 0;
    }
    .pipe__meta {
      grid-area: meta;
    }
    .pipe__status {
      grid-area: status;
    }
    .pipe__stages {
      grid-area: stages;
    }
    .pipe__stage-current {
      display: flex;
    }
    /* Ambient decoration recedes on small screens (Protocolo Vivo brief):
       the frame's signal marks go, the corner brackets stay (cheap, edge-only). */
    .research::after {
      display: none;
    }
  }

  /* --- Phone (≤ 30rem): the two-level tablet composition stacks fully —
     id + title + tags, then the node strip, then the status (the mandated
     reading order). The status row un-mirrors (left-aligned, inline pair) and
     the active-row contour tightens its outset to stay inside the narrower
     band padding. Still no fixed heights anywhere — every box is content-driven. --- */
  @media (max-width: 30rem) {
    .research {
      padding: 1.25rem 1rem;
    }
    .pipe {
      padding: 0.85rem 0.8rem 0.95rem;
    }
    .pipe__row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'meta'
        'stages'
        'status';
      row-gap: 0.6rem;
    }
    .pipe__status {
      flex-direction: row;
      align-items: baseline;
      gap: 0.6rem;
      text-align: left;
    }
    .pipe__row:hover::before,
    .pipe__row:focus-within::before {
      inset: 0.3rem -0.35rem;
    }
    .pipe__row:hover::after {
      left: -0.68rem;
      width: 0.36rem;
      height: 0.36rem;
    }
  }

  /* --- Music NOTE-RAIN register (US-042, manual §7.3 / US-G2): the theme break
     made meaningful while staying Matrix-adjacent. KEEPS the mono type stacks
     (kinship with Matrix, AC4 — no type switch, unlike the Sky register) over the
     same dark ~90%-void panel, but accented with the --note-accent violet: a left
     accent rule + a decorative quaver cue + a faint violet glow, echoing the
     violet the live Note-rain carries on its note heads. Body text --note-hi over
     ~90% void holds well past 4.5:1 (P6); --note-* tokens only (P7). No motion
     here; US-026 owns the reveal. --- */
  .music {
    background: var(--crt-lines-note), var(--surface-panel);
    border: 1px solid color-mix(in srgb, var(--note-accent) 45%, transparent);
    border-left: 3px solid var(--note-accent);
    border-radius: 4px;
    padding: 1.4rem 1.75rem;
    box-shadow: 0 2px 22px color-mix(in srgb, var(--note-accent) 14%, transparent);
    /* US-708 violet register: the focus ring re-registers DOM-scoped on the
       panel (the .aero --focus-ring precedent — NEVER [data-theme]-keyed);
       --note-accent ≈6.4:1 on the void surface (≥3:1 ring, US-046). The
       --u604-* FX hooks that sat beside it are GONE with the US-604 hover
       layer (2026-08-09 Frequency Bands — its last selectors left the page,
       so the setters were dead declarations). */
    --focus-ring: var(--note-accent);
  }
  /* US-1714 liner-notes setting (the quaver cue this replaced is gone; Icon.astro
     keeps the glyph unused, the `plane` precedent). Two moves, both PAINT on the
     existing paragraph — no DOM node, no string, nothing in the a11y tree, so the
     census and the playlist grid below are untouched (OD-2):
       (1) a short violet lead-in rule as a content:"" ::before (the US-1705
           decorative-rule rule) — it hangs off .music__intro rather than a wrapper
           because music is the NOTE register, never alien-decoded, so the
           "don't pseudo a decode host" constraint doesn't apply here;
       (2) ::first-line emphasis — tracked, weighted, in --note-head. ::first-line
           only accepts font/colour/spacing properties, and both endpoints of the
           paragraph already use --note-head, so the emphasis is metric-only where
           it counts and can never drop below the body's contrast. */
  .music__intro {
    margin: 0;
    /* US-708: body text moves to the violet-family light token (--note-head
       #EDE6FF ≈16.6:1 composited over black worst case — the register's
       --mx-green-hi role), completing the violet re-register. */
    color: var(--note-head);
    /* The lede scale grows only the CEILING: the 0.9rem floor is the pre-US-1714
       value, so the narrow justified column at 360 keeps its old, tight wrapping
       (a bigger floor fits fewer mono chars per line and opens ugly justification
       gaps there). */
    font-size: clamp(0.9rem, 1.7vw, 1.1rem);
    line-height: 1.8;
  }
  .music__intro::before {
    content: '';
    display: block;
    width: 3.5rem;
    height: 1px;
    margin-bottom: 0.85rem;
    background: var(--note-accent);
  }
  .music__intro::first-line {
    color: var(--note-head);
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  /* "01 — Cover Flow" album selector (2026-08-09; supersedes the US-1609
     playlist grid — the .music panel, intro and gallery rules above/below are
     untouched). ONE <ol> renders TWO presentations keyed on data-cf-ready (the
     experience-chapters P5 idiom):
       · :not([data-cf-ready]) — the no-JS / pre-mount baseline: a horizontal
         scroll-snap row where EVERY album shows cover + title + artist +
         position + its real link. Fully functional without the module; the
         step/dot controls stay hidden so no dead chrome ships.
       · [data-cf-ready] — the Cover Flow stage: every item stacked in ONE grid
         cell (grid-area 1/1, align start) and pushed aside by data-pos-keyed
         transforms, so ALL geometry derives from the signed offset (never
         per-album rules; a longer collection self-assigns). Neighbour covers
         share the active cover's visual centre for free: items are top-aligned,
         a neighbour's box is just its cover (meta display:none), and scale()
         shrinks around that box centre. |pos| ≤ 2 visible (≤ 5 covers), ±3 is a
         laid-out fade buffer (visibility:hidden keeps it out of the a11y tree
         and the tab order), 'out' is display:none — the windowing rule.
     The stage clips ONLY horizontally (overflow-x: clip + overflow-y: visible —
     a valid pair, unlike hidden) so edge covers crop at narrow widths while
     focus rings are never cut; every focusable control sits well inside the
     clip. Geometry lives in the --cf-* knobs; transform/opacity are the only
     transitioned properties, gated on html[data-motion='full'] (reduced =
     instant flips, same states). --note-* tokens only (P7); text tokens hold
     ≥4.5:1 over the panel with the brightest rain head behind (P6 — head@72%
     ≈7.4:1, the dossier alpha-dim idiom; bare --note-accent ≈3.8:1 is used
     ONLY for borders/icon glyphs, never prose). */
  /* One vertical rhythm for the titled collection rows (a future collection
     is a data edit — this wrapper spaces any count). */
  .music__collections {
    margin-top: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }
  /* Collection title — a real data-sourced <h3> (each shelf is a named group;
     the US-020 "distinct, non-repeating names" heading test). Census moves
     with the data (+1 per collection). Centred over its stage; the shared
     '> ' h3 prompt prefix is suppressed (content:none, the .skills__category
     precedent — the Cover Flow brief reads as a hi-fi shelf, not a console);
     text-transform is visual only, the accname keeps the authored casing. */
  .music__collection-title {
    margin: 0 0 0.9rem;
    text-align: center;
    color: var(--note-head);
    font-size: clamp(0.95rem, 1.9vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .music__collection-title::before {
    content: none;
  }
  .music__cf {
    position: relative;
    /* Stage knobs: the active cover edge; neighbour scale/opacity; x steps as
       fractions of the cover so one length re-tunes the whole stage. Base =
       5 covers filling the ~824px stage at the 58rem column cap. */
    --cf-cover: clamp(11rem, 23vw, 13.5rem);
    --cf-s1: 0.76;
    --cf-s2: 0.58;
    --cf-o1: 0.85;
    --cf-o2: 0.55;
    --cf-x1: calc(var(--cf-cover) * 0.86);
    --cf-x2: calc(var(--cf-cover) * 1.62);
    --cf-x3: calc(var(--cf-cover) * 2.05);
    /* Shallow Cover-Flow nod — far from the extreme tilts the brief bans. */
    --cf-tilt: 9deg;
    /* US-603 reset: selector metadata is centred display text, never justified
       or auto-hyphenated prose. */
    text-align: center;
    -webkit-hyphens: manual;
    hyphens: manual;
  }
  .music__cf-list {
    list-style: none;
    margin: 0;
    padding: 0.3rem 0.3rem 0.5rem;
    display: flex;
    gap: 1.1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .music__cf-item {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .music__cf:not([data-cf-ready]) .music__cf-item {
    flex: 0 0 min(70vw, 13rem);
    scroll-snap-align: center;
  }
  .music__cf-cover {
    margin: 0;
    position: relative;
    inline-size: 100%;
    /* 1:1 reservation — the box exists before any cover image arrives, so a
       slow/failed load can never shift layout (CLS 0 by construction). */
    aspect-ratio: 1;
    background: var(--surface-code);
    border: 1px solid color-mix(in srgb, var(--note-accent) 40%, transparent);
    border-radius: 2px;
    overflow: hidden;
  }
  /* The generated placeholder art always sits under the (optional) real cover:
     demo entries and missing covers show it outright, a failed real cover falls
     back to it (data-cover-failed below). set:html svg carries NO scoped cid —
     reach it with the scoped-parent + :global-descendant pattern (US-036). */
  .music__cf-art {
    position: absolute;
    inset: 0;
    display: block;
  }
  .music__cf-art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .music__cf-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .music__cf-item[data-cover-failed] .music__cf-img {
    display: none;
  }
  /* Cover-as-link (2026-08-09 correction — the visible "Open on TIDAL" button
     is GONE, not hidden): the cover carries TWO mutually-exclusive full-cover
     overlays, SIBLINGS never nested — the album <a> (real link, full
     accessible name via the `music.openAlbum` template + a discreet ↗ badge)
     and the selection <button> (named by the album it selects). Exactly ONE is
     display:block at any time, so no transparent control ever overlaps
     another:
       · baseline (:not([data-cf-ready])): every cover IS its album link (the
         no-JS snap row keeps all 49 real links) and the selection buttons —
         dead without JS — never render.
       · ready: the ACTIVE cover shows the link (press the centred cover →
         TIDAL), every other cover shows its selection button (press a side
         cover → it centres, never navigates; press again once centred →
         TIDAL). An album without a URL renders NO link at all — its centred
         cover is simply not interactive (the meta shows the linkPending text).
     The swap is display-only on absolutely-positioned overlays ⇒ zero layout
     shift; focus continuity across the swap lives in cover-flow.ts. */
  .music__cf-cover-open,
  .music__cf-cover-select {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    z-index: 1;
  }
  /* Discreet external cue on the active cover — paint inside the link, never
     a separate control; always visible (the link must not depend on hover). */
  .music__cf-cover-ext {
    position: absolute;
    inset-block-start: 0.4rem;
    inset-inline-end: 0.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.4rem;
    block-size: 1.4rem;
    background: color-mix(in srgb, var(--note-void) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--note-accent) 55%, transparent);
    border-radius: 2px;
    color: var(--note-accent);
    font-size: 0.8rem;
    line-height: 1;
  }
  .music__cf:not([data-cf-ready]) .music__cf-cover-select {
    display: none;
  }
  .music__cf[data-cf-ready] .music__cf-item[aria-current='true'] .music__cf-cover-select {
    display: none;
  }
  .music__cf[data-cf-ready] .music__cf-item:not([aria-current='true']) .music__cf-cover-open {
    display: none;
  }
  /* Focus ring moved UP to the figure (the US-1701 :has() idiom): the overlay
     sits inside the cover's overflow:hidden clip, so its own outline would be
     cut — the replacement ring draws on the figure itself (never removed
     without replacement; both roles covered, keyboard reaches side covers
     too). The ring RULES live further down, AFTER the decorative selection
     frame: both write the ONE `outline` property on the figure, so the focus
     ring must out-cascade the frame (specificity tied at the frame's level +
     source order) — accessibility beats decoration while focus is held, the
     frame returns on blur. */
  .music__cf-cover-open:focus-visible,
  .music__cf-cover-select:focus-visible {
    outline: none;
  }
  .music__cf-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.9rem;
    inline-size: min(100%, 26rem);
  }
  .music__cf-title {
    margin: 0;
    color: var(--note-head);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.4vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    /* Long titles wrap (multiline is fine, the accessible name stays whole);
       anywhere handles unbroken tokens without growing min-content (US-1706). */
    overflow-wrap: anywhere;
  }
  .music__cf-artist {
    margin: 0;
    color: color-mix(in srgb, var(--note-head) 72%, transparent);
    font-size: clamp(0.85rem, 1.6vw, 1rem);
    letter-spacing: 0.05em;
    overflow-wrap: anywhere;
  }
  .music__cf-counter {
    margin: 0.15rem 0 0;
    /* 72% is the P6 floor here, not a taste call: 65% read 4.21:1 over the
       panel with the brightest rain head behind (the in-situ probe) — the
       dossier 72% alpha-dim idiom clears 4.5:1; hierarchy rides the size. */
    color: color-mix(in srgb, var(--note-head) 72%, transparent);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
  }
  /* Album without a real Tidal album URL: explicit pending TEXT in the meta
     (never a fake anchor, never a button-look — the cover simply is not
     interactive; P1/P3 — real shown text, so the ≥4.5:1 head@72%, not
     disabled-dim). */
  .music__cf-pending {
    margin: 0.35rem 0 0;
    color: color-mix(in srgb, var(--note-head) 72%, transparent);
    font-size: 0.9rem;
    font-style: italic;
  }

  /* --- Ready mode: the stage. --- */
  .music__cf[data-cf-ready] .music__cf-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    align-items: start;
    gap: 0;
    overflow-x: clip;
    overflow-y: visible;
    perspective: 60rem;
    /* Floor ≈ active cover + one-line meta: the off-screen mount (300px IO
       lead) can only tighten the box into this reservation, never grow it
       mid-view; long titles still grow it naturally (no fixed heights).
       Re-based 11 → 8.5rem when the meta lost its link-button row (the
       cover-as-link correction). */
    min-block-size: calc(var(--cf-cover) + 8.5rem);
  }
  .music__cf[data-cf-ready] .music__cf-item {
    grid-area: 1 / 1;
    inline-size: var(--cf-cover);
  }
  .music__cf[data-cf-ready] .music__cf-item:not([aria-current='true']) {
    cursor: pointer;
  }
  .music__cf[data-cf-ready] .music__cf-item:not([aria-current='true']) .music__cf-meta {
    display: none;
  }
  /* The wider-than-cover meta re-centres under the active cover via symmetric
     negative margins (the li hugs the cover so neighbour hit-boxes and
     transform centres stay honest). */
  .music__cf[data-cf-ready] .music__cf-meta {
    inline-size: min(88vw, 26rem);
    margin-inline: calc((var(--cf-cover) - min(88vw, 26rem)) / 2);
  }
  /* Selection frame: border + offset outline + glow on top of the scale/
     position/semantics cues — never colour alone (and never the focus ring,
     which stays the 2px offset --focus-ring outline on the CONTROLS). */
  .music__cf[data-cf-ready] .music__cf-item[aria-current='true'] .music__cf-cover {
    border-color: var(--note-accent);
    outline: 1px solid color-mix(in srgb, var(--note-accent) 70%, transparent);
    outline-offset: 5px;
    box-shadow: 0 0 20px color-mix(in srgb, var(--note-accent) 22%, transparent);
  }
  /* The figure focus ring (see the overlay comment above): specificity tied
     with the selection-frame rule + declared AFTER it, so while the cover
     link/button holds visible focus the violet --focus-ring wins the shared
     `outline` slot; the decorative frame's border + glow stay. */
  .music__cf .music__cf-item .music__cf-cover:has(.music__cf-cover-open:focus-visible),
  .music__cf .music__cf-item .music__cf-cover:has(.music__cf-cover-select:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  /* data-pos geometry — the whole stage derives from the signed offset. */
  .music__cf[data-cf-ready] .music__cf-item[data-pos='0'] {
    z-index: 3;
  }
  .music__cf[data-cf-ready] .music__cf-item[data-pos='1'] {
    transform: translateX(var(--cf-x1)) scale(var(--cf-s1)) rotateY(calc(var(--cf-tilt) * -1));
    opacity: var(--cf-o1);
    z-index: 2;
  }
  .music__cf[data-cf-ready] .music__cf-item[data-pos='-1'] {
    transform: translateX(calc(var(--cf-x1) * -1)) scale(var(--cf-s1)) rotateY(var(--cf-tilt));
    opacity: var(--cf-o1);
    z-index: 2;
  }
  .music__cf[data-cf-ready] .music__cf-item[data-pos='2'] {
    transform: translateX(var(--cf-x2)) scale(var(--cf-s2)) rotateY(calc(var(--cf-tilt) * -1));
    opacity: var(--cf-o2);
    z-index: 1;
  }
  .music__cf[data-cf-ready] .music__cf-item[data-pos='-2'] {
    transform: translateX(calc(var(--cf-x2) * -1)) scale(var(--cf-s2)) rotateY(var(--cf-tilt));
    opacity: var(--cf-o2);
    z-index: 1;
  }
  .music__cf[data-cf-ready] .music__cf-item[data-pos='3'],
  .music__cf[data-cf-ready] .music__cf-item[data-pos='-3'] {
    opacity: 0;
    visibility: hidden;
    z-index: 0;
  }
  .music__cf[data-cf-ready] .music__cf-item[data-pos='3'] {
    transform: translateX(var(--cf-x3)) scale(var(--cf-s2));
  }
  .music__cf[data-cf-ready] .music__cf-item[data-pos='-3'] {
    transform: translateX(calc(var(--cf-x3) * -1)) scale(var(--cf-s2));
  }
  .music__cf[data-cf-ready] .music__cf-item[data-pos='out'] {
    display: none;
  }
  .music__cf[data-cf-ready] .music__cf-item:not([aria-current='true']):hover {
    opacity: 1;
  }
  .music__cf[data-cf-ready] .music__cf-item:not([aria-current='true']):hover .music__cf-cover {
    border-color: var(--note-accent);
  }

  /* --- Controls (hidden until the module wires them — no dead chrome). --- */
  .music__cf:not([data-cf-ready]) .music__cf-arrows,
  .music__cf:not([data-cf-ready]) .music__cf-dots {
    display: none;
  }
  /* The wrapper dissolves at desktop (display:contents) so both arrows position
     against .music__cf; below 40rem it becomes the accessible control row. */
  .music__cf-arrows {
    display: contents;
  }
  .music__cf-arrow {
    position: absolute;
    /* Mock composition: the step controls flank the metadata zone, clear of the
       side covers above and of the centred meta column beside. */
    inset-block-start: calc(var(--cf-cover) + 2.6rem);
    inline-size: 2.75rem;
    block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: var(--surface-code);
    border: 1px solid color-mix(in srgb, var(--note-accent) 55%, transparent);
    border-radius: 2px;
    color: var(--note-accent);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    z-index: 4;
  }
  .music__cf-arrow--prev {
    inset-inline-start: 0;
  }
  .music__cf-arrow--next {
    inset-inline-end: 0;
  }
  .music__cf-arrow:hover:not(:disabled) {
    border-color: var(--note-accent);
    color: var(--note-head);
  }
  .music__cf-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .music__cf-dots {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
  .music__cf-dot-cell {
    margin: 0;
  }
  /* 44px hit area, small visual dot — position conveyed by fill + aria-current,
     never colour alone. */
  .music__cf-dot {
    inline-size: 2.75rem;
    block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .music__cf-dot::before {
    content: '';
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    border: 1px solid var(--note-accent);
  }
  .music__cf-dot[aria-current='true']::before {
    background: var(--note-accent);
  }
  .music__cf-dot:hover::before {
    background: color-mix(in srgb, var(--note-accent) 45%, transparent);
  }
  /* Honest empty-collection state (production with the demo flag off) — real
     shown text on the light token (the US-033 pending-message rule). */
  .music__albums-pending {
    margin: 1.4rem 0 0;
    color: var(--note-head);
    font-size: clamp(0.85rem, 1.5vw, 0.95rem);
    font-style: italic;
  }
  /* Motion: transform/opacity + colour eases only, behind the resolved motion
     preference (the US-604 idiom — states flip instantly on both paths). */
  :global(html[data-motion='full']) .music__cf-item {
    transition:
      transform 380ms cubic-bezier(0.22, 0.61, 0.21, 1),
      opacity 380ms ease;
  }
  :global(html[data-motion='full']) .music__cf-arrow,
  :global(html[data-motion='full']) .music__cf-cover-ext,
  :global(html[data-motion='full']) .music__cf-item .music__cf-cover {
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease,
      opacity 160ms ease;
  }
  /* Tablet: three visible covers (active + one neighbour each side). */
  @media (max-width: 56rem) {
    .music__cf {
      --cf-cover: clamp(12rem, 34vw, 16rem);
      --cf-x1: calc(var(--cf-cover) * 0.8);
    }
    .music__cf[data-cf-ready] .music__cf-item[data-pos='2'],
    .music__cf[data-cf-ready] .music__cf-item[data-pos='-2'] {
      opacity: 0;
      visibility: hidden;
      z-index: 0;
    }
  }
  /* Mobile: active cover + edge peeks, flat (no tilt), controls in a row below
     the metadata (≥44px targets throughout). 55vw, not 62: the visible peek =
     (stage half) − (active half) regardless of the x step, and at 62vw that
     left a ~3px sliver — 55vw buys ~24px of genuinely tappable neighbour per
     side (the 44px arrows stay the primary mobile control). */
  @media (max-width: 40rem) {
    .music__cf {
      --cf-cover: min(55vw, 14rem);
      --cf-x1: calc(var(--cf-cover) * 0.72);
      --cf-tilt: 0deg;
    }
    .music__cf-arrows {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-top: 0.9rem;
    }
    .music__cf-arrow {
      position: static;
    }
  }
  /* Gallery drop-in (AC4 / P4): the same auto-fit grid as aeronautics — collapses
     to one column before 360px, fixed-ratio cells so real images drop in with zero
     CLS. Empty today (placeholders filtered out). */
  .music__gallery {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.75rem;
  }
  .music__gallery-item {
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--note-accent) 40%, transparent);
    border-radius: 4px;
    overflow: hidden;
  }
  .music__gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* --- Aeronautics "04 — FLIGHT STRIP" (owner ask 2026-08-08; supersedes the
     US-1403/US-1608 ledger-table presentation — the sky register, the honest
     live-data contract and the US-1404 module all survive). The .aero panel is
     UNCHANGED from US-041: the page's one LIGHT instrument surface
     (--crt-lines-sky over 96% --sky-haze) so dark --sky-ink text holds ≈12:1
     regardless of backdrop (P6), sky type stacks (Saira display chrome /
     Inter body), --sky-* tokens only (P7), and the DOM-scoped dark focus ring
     (US-046). Composition: masthead (credentials rail + measured intro) →
     HUD horizon divider → flight-strip bay → summary rail. --- */
  .aero {
    /* 97.5% haze (was 96%, second pass): the live scene's bright shapes were
       ghosting through the 4% gap as a pale swath across the logbook — the
       content must dominate the texture. The sky tab fill in Section.astro is
       kept in sync (the US-707 tab/panel merge). */
    background: var(--crt-lines-sky), color-mix(in srgb, var(--sky-haze) 97.5%, transparent);
    border: 1px solid color-mix(in srgb, var(--sky-blue) 50%, transparent);
    border-radius: 6px;
    padding: 1.5rem 1.75rem;
    color: var(--sky-ink);
    font-family: var(--font-sky-body);
    box-shadow: 0 2px 18px color-mix(in srgb, var(--sky-ink) 12%, transparent);
    /* US-046: this is the page's only LIGHT content surface, so any focusable
       control inside it gets the dark sky-ink ring instead of the bright phosphor
       default — keeping the keyboard focus ring ≥4.5:1 over the haze (AC2). The
       sticky nav is NOT a descendant of .aero, so it keeps the bright root ring
       even while the page theme is sky. */
    --focus-ring: var(--sky-ink);
    /* ONE shared column template for the header rail AND every runtime strip
       <dl> (custom properties cross the Astro cid boundary — the US-1715 rule),
       so the bay's columns align by construction. Route is the dominant track;
       the numeric mins are sized so the longer ES headers (MATRÍCULA /
       ATERRIZAJES) never wrap or clip at the 40rem grid floor — at the second
       pass's larger 0.72rem header face the landings min is 6.2rem. */
    --log-grid:
      minmax(8.5rem, 2.2fr) minmax(6.2rem, 1fr) minmax(6.8rem, 1.1fr) minmax(3.8rem, 0.6fr)
      minmax(6.2rem, 0.65fr);
    /* Strip band faces: paper-strip light over the haze bay — 70% cloud
       (second pass; 55% let the panel scanlines + scene ghost through the
       band) so each strip reads as an opaque physical slip and its text sits
       on clean paper. Hover is EXTREMELY subtle (16% blue — a strip is
       static data, nothing must look clickable). */
    --strip-face: color-mix(in srgb, var(--sky-cloud) 70%, transparent);
    --strip-face-hover: color-mix(in srgb, var(--sky-blue) 16%, transparent);
    --strip-edge: color-mix(in srgb, var(--sky-ink) 30%, transparent);
  }
  /* Masthead (second pass — the reference composition): the credentials as a
     CENTERED horizontal row on the section's main axis (no side rail — the
     two-column masthead fragmented the intro into short lines), the intro
     below as a centered ~80ch block. The measure cap is legal per US-702
     because .aero sits in the ragged-right console reset list, so box and
     text never disagree; the row wraps naturally at narrow widths. */
  .aero__masthead {
    display: block;
  }
  /* Verified-credential marks — small contained badges gated on the real
     credential flags (meta.isLicensedPilot US-041; meta.isNightRated
     2026-07-03). The visible text carries each accessible name; the glyphs
     (currentColor → --sky-ink) are aria-hidden decoration (P4). Title case =
     the localized content's own casing (never forced uppercase — owner
     brief, second pass); pill geometry per the reference. */
  .aero__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 0 0 1.1rem;
  }
  .aero__credential {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.3rem 0.85rem;
    max-width: 100%;
    color: var(--sky-ink);
    background: color-mix(in srgb, var(--sky-blue) 22%, transparent);
    border: 1px solid color-mix(in srgb, var(--sky-blue) 55%, transparent);
    border-radius: 999px;
    font-family: var(--font-sky-display);
    font-size: clamp(0.76rem, 1.4vw, 0.86rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  /* Faint HUD: an artificial-horizon line (the two --sky-blue rules) crossing a
     centred aircraft reference symbol (—◦—). Decorative (aria-hidden in markup),
     so it never enters the a11y tree; --sky-* tokens only (P7). Since the
     Flight Strip recompose it is the thin technical separation masthead →
     logbook (the old .aero__logbook border-top retired with the tiles) —
     second pass: COMPACT and clearly secondary (short centred run, tight
     margins, lower-alpha lines) so it never opens a visual hole between
     masthead and logbook. */
  .aero__hud {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 24rem;
    margin: 0.9rem auto 0.85rem;
  }
  .aero__hud-line {
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--sky-blue) 38%, transparent);
  }
  .aero__hud-craft {
    position: relative;
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    border: 1.5px solid var(--sky-blue);
    border-radius: 50%;
  }
  .aero__hud-craft::before,
  .aero__hud-craft::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 9px;
    height: 1.5px;
    background: var(--sky-blue);
    transform: translateY(-50%);
  }
  .aero__hud-craft::before {
    right: 100%;
    margin-right: 3px;
  }
  .aero__hud-craft::after {
    left: 100%;
    margin-left: 3px;
  }
  .aero__intro {
    margin: 0;
    /* 62 CSS ch of Inter ('0' advance ≈ 0.61em) ≈ 75 average characters per
       line — the comfortable 65–85 target measure. NOT 80ch: the ch unit
       overshoots average-character counts by ~25% in this face. */
    max-width: 62ch;
    margin-inline: auto;
    color: var(--sky-ink);
    font-size: clamp(0.9rem, 1.6vw, 1rem);
    line-height: 1.7;
  }
  /* Flight logbook — the strip BAY. The old ledger <table> + pinned wrap +
     counter tiles are retired; the honest role=status line survives (pending
     TRUE under no-JS, swapped by the US-1404 module; min-block-size reserves
     its line so pending↔loading swaps never shift layout). On SUCCESS the
     module clip-hides it via the global .alien-sr utility — the summary rail
     is THE one visual representation of the totals (no duplicate readout
     above the bay), while the live region still announces and the visible
     pending/loading/error states are untouched. */
  .aero__logbook {
    margin-top: 0;
  }
  /* Centred block heading between two hairline rules (the reference's
     "> FLIGHT LOGBOOK" transition into the strip system — the rules are
     pseudos on the flex wrapper, the h3 stays the one census heading). */
  .aero__log-titlebar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 0.5rem;
  }
  .aero__log-titlebar::before,
  .aero__log-titlebar::after {
    content: '';
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--sky-ink) 28%, transparent);
  }
  .aero__log-title {
    margin: 0;
    color: var(--sky-ink);
    font-family: var(--font-sky-display);
    font-size: clamp(1.02rem, 2vw, 1.16rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .aero__log-status {
    margin: 0 0 0.75rem;
    min-block-size: 1.6em;
    text-align: center;
    color: var(--sky-ink);
    font-style: italic;
    font-size: clamp(0.8rem, 1.5vw, 0.88rem);
    line-height: 1.6;
  }
  /* The bay's visual column header — aria-hidden PRESENTATION: each strip's
     own dt/dd pairs carry the semantic labels, so AT hears exactly one label
     per value and never a duplicate. It doubles as the module's locale-blind
     dt-label source (data-log-col). Grid mode only; card mode (<40rem) shows
     the per-field dt labels instead. The transparent border-left mirrors the
     strips' 3px holder bar so rail and strip columns align exactly. */
  .aero__log-head {
    display: grid;
    grid-template-columns: var(--log-grid);
    border-left: 3px solid transparent;
    border-bottom: 1px solid color-mix(in srgb, var(--sky-ink) 45%, transparent);
  }
  /* Second pass: readable without zoom (0.72rem, ~92% ink, moderate 0.06em
     tracking) — clearly labels, never protagonists; metadata columns centre
     with their values (the reference's strip-field alignment), route stays
     start-aligned with its dominant value. */
  .aero__log-head-cell {
    padding: 0 0.8rem 0.4rem;
    font-family: var(--font-sky-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    color: color-mix(in srgb, var(--sky-ink) 92%, var(--sky-haze));
  }
  .aero__log-head-cell[data-log-col='route'] {
    text-align: start;
  }
  .aero__strips {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    font-size: clamp(0.84rem, 1.5vw, 0.95rem);
    line-height: 1.45;
  }
  @media (min-width: 40rem) {
    .aero__strips {
      /* Zero-CLS reservation — a MIN, never a fixed height (the bay grows
         freely with content): ≈ the default hydrated stack of 8 single-line
         strips (the 1.32em route line × 1.45 lh ≈ 1.91em + 1.36rem block
         padding + 2px borders each) + 7 × 6px grooves — STRIPS ONLY, so the
         hydrated bay fills its reservation exactly and the Show-all control
         sits immediately after the last band (a button-inclusive reserve
         left a phantom bay tail between strips and control). The control's
         own ~48px appears with hydration behind the loader's 300px IO lead,
         like the whole card-mode bay (the US-1715 narrow-width precedent). */
      min-block-size: calc(15.3em + 10.9rem + 58px);
    }
  }
  /* Every strip is RUNTIME-created by flight-log.ts — no Astro scoped cid, so
     all strip rules ride the scoped-parent + :global-descendant pattern (the
     US-036/US-1404 boundary; .aero__strips is SSR and keeps the cid). A strip
     is a <li> band: paper-strip face, thin technical edge, the --sky-blue
     holder bar at the left cut; 3px grooves separate the bay's slots. Strips
     are STATIC data (no action → no link/button, no pointer affordance). */
  .aero__strips :global(li) {
    background: var(--strip-face);
    border: 1px solid var(--strip-edge);
    border-left: 3px solid var(--sky-blue);
    border-radius: 2px;
  }
  .aero__strips :global(li + li) {
    /* 6px bay groove (second pass; 3px read as table-row spacing) — the
       spatial separation + individual outline are what make each flight an
       unmistakable physical slip, never zebra striping. */
    margin-top: 6px;
  }
  .aero__strips[data-log-collapsed] :global(li[data-log-overflow]) {
    display: none;
  }
  .aero__strips :global(dl) {
    margin: 0;
  }
  .aero__strips :global(.aero__f) {
    position: relative;
    min-width: 0;
  }
  .aero__strips :global(dt) {
    font-family: var(--font-sky-display);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sky-ink) 82%, var(--sky-haze));
  }
  .aero__strips :global(dd) {
    margin: 0;
    overflow-wrap: anywhere;
  }
  /* Route: THE dominant datum — display face at 1.32em (second pass; 1.18
     still read row-like), first thing the eye finds on a scan. The origin →
     destination arrow is part of the composed text (AT reads "CHY right
     arrow ATE", so the direction survives non-visually). Long routes still
     wrap via the dd overflow-wrap (fixture-proven). */
  .aero__strips :global(.aero__f-route dd) {
    font-family: var(--font-sky-display);
    font-size: 1.32em;
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  .aero__strips :global(.aero__f-hours dd),
  .aero__strips :global(.aero__f-landings dd) {
    font-weight: 600;
  }
  .aero__strips :global(.aero__f-date dd),
  .aero__strips :global(.aero__f-hours dd),
  .aero__strips :global(.aero__f-landings dd) {
    font-variant-numeric: tabular-nums;
  }
  /* The route dt is visually hidden at EVERY width (the value is the strip's
     self-evident headline; the dt still labels it for AT) — the clip recipe
     inline, because the responsive dt visibility below can't ride a fixed
     visually-hidden utility class. */
  .aero__strips :global(.aero__f-route dt) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }
  @media (min-width: 40rem) {
    /* GRID MODE: one shared track list (--log-grid) per strip, aligned with
       the header rail by construction; DOTTED verticals draw the strip's
       internal field boxes (the reference's progress-strip grammar) and the
       taller padding gives each band physical presence. All dts hide
       visually (the rail is the visible header); metadata columns centre
       under their labels, route stays the start-aligned headline, vertically
       centred in the band. */
    .aero__strips :global(dl) {
      display: grid;
      grid-template-columns: var(--log-grid);
      align-items: center;
    }
    .aero__strips :global(.aero__f) {
      padding: 0.68rem 0.8rem;
    }
    .aero__strips :global(.aero__f + .aero__f) {
      border-left: 1px dotted color-mix(in srgb, var(--sky-ink) 35%, transparent);
    }
    .aero__strips :global(dt) {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      clip-path: inset(50%);
      overflow: hidden;
      white-space: nowrap;
    }
    .aero__strips :global(.aero__f-date),
    .aero__strips :global(.aero__f-reg),
    .aero__strips :global(.aero__f-hours),
    .aero__strips :global(.aero__f-landings) {
      text-align: center;
    }
  }
  @media (max-width: 39.99rem) {
    /* CARD MODE — the SAME DOM reflowed: the global header hides, each strip
       becomes a vertical band (route headline first, then labelled metadata
       fields wrapping — date + registration, then the hours/landings metrics
       row at ~320px widths, organically via flex-wrap). The dts become the
       visible micro-labels so no value reads ambiguous. */
    .aero__log-head {
      display: none;
    }
    .aero__strips :global(li) {
      padding: 0.7rem 0.8rem 0.75rem;
    }
    .aero__strips :global(dl) {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      column-gap: 1.2rem;
      row-gap: 0.45rem;
    }
    .aero__strips :global(.aero__f-route) {
      flex: 1 0 100%;
    }
    .aero__strips :global(.aero__f-route dd) {
      font-size: clamp(1.1rem, 4.6vw, 1.28rem);
    }
    .aero__strips :global(dt) {
      display: block;
      margin-bottom: 0.1rem;
      font-size: 0.6rem;
    }
  }
  /* Ambient strip hover (the US-1712 darken ask, re-based on the strip face):
     paint only, instant on both motion paths — only the ease and the one-shot
     hydration entrance ride data-motion='full' (the US-604 idiom, P5). The
     entrance is the reveal system's language applied to runtime content (the
     [data-reveal] targets can't cover strips created after the section's
     reveal fired): finite, ~35ms stagger capped at 10 steps via the module's
     --strip-i, `backwards` fill so no strip flashes before its turn. The calm
     path shows strips instantly. In situ over the hover tint the ink fields
     still read ≥9:1 (P6). */
  .aero__strips :global(li:hover) {
    background: var(--strip-face-hover);
  }
  :global(html[data-motion='full']) .aero__strips :global(li) {
    transition: background-color 180ms ease;
    animation: aero-strip-in 220ms ease-out backwards;
    animation-delay: calc(min(var(--strip-i, 0), 10) * 35ms);
  }
  @keyframes aero-strip-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  /* The Show-all disclosure: an SSR <button> hidden until the module counts
     more flights than the 8 default slots (so no-JS ships zero dead
     controls). A REAL control kept SECONDARY (second pass — the dashed
     full-box read as an empty panel): a quiet borderless text row right
     after the last band, full-width so Show all / Show fewer occupy the
     exact same place (no lateral jumps); the 44px touch target lives in the
     min-height, not in visual bulk. Hover/focus tint + the DOM-scoped dark
     focus ring (US-046); the chevron is CSS alt-'' generated content so the
     accessible name stays the label alone. [hidden] is guarded against the
     display override (the classic trap). */
  .aero__log-more {
    display: flex;
    width: 100%;
    min-height: 2.75rem;
    margin-top: 2px;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.3rem 0.75rem;
    background: transparent;
    border: 0;
    border-radius: 2px;
    color: color-mix(in srgb, var(--sky-ink) 88%, var(--sky-haze));
    font-family: var(--font-sky-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .aero__log-more[hidden] {
    display: none;
  }
  .aero__log-more::after {
    content: '▾' / '';
  }
  .aero__log-more[aria-expanded='true']::after {
    content: '▴' / '';
  }
  .aero__log-more:hover,
  .aero__log-more:focus-visible {
    background: color-mix(in srgb, var(--sky-blue) 26%, transparent);
  }
  :global(html[data-motion='full']) .aero__log-more {
    transition: background-color 160ms ease;
  }
  /* Summary rail — the logbook's TOTALS close (second pass: the solid ink
     bar read as an alien dark banner; the reference rail is a LIGHT bordered
     bar in the strip family, just a touch more saturated than the bands).
     Two equivalent areas split by a subtle centre divider; each metric
     renders VALUE over LABEL, centred — flex column-reverse, so the DOM
     stays the semantic dt→dd order while the visual leads with the number.
     The dd min-inline-size reserves the widest live value ('15:14 h' ≈ 7ch)
     so the em-dash → number swap never shifts layout (the US-1403 tile
     rule). Ink over the blue-tinted face is panel-internal ≥9:1 (P6);
     --sky-* tokens only (P7). */
  .aero__log-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 6px 0 0;
    background: color-mix(in srgb, var(--sky-blue) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--sky-blue) 55%, transparent);
    border-radius: 2px;
    color: var(--sky-ink);
  }
  .aero__log-total {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 0.1rem;
    padding: 0.7rem 0.85rem 0.6rem;
    text-align: center;
  }
  .aero__log-total + .aero__log-total {
    border-left: 1px solid color-mix(in srgb, var(--sky-ink) 22%, transparent);
  }
  .aero__log-total dt {
    font-family: var(--font-sky-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sky-ink) 85%, var(--sky-haze));
  }
  .aero__log-total dd {
    margin: 0;
    min-inline-size: 7ch;
    font-family: var(--font-sky-display);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 600;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  /* Gallery drop-in (AC4): an auto-fit grid that collapses to one column before
     360px (the US-019 grid recipe), each image cover-fit in a fixed-ratio cell so
     real images drop in with zero CLS. Empty today (placeholders filtered out). */
  .aero__gallery {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.75rem;
  }
  .aero__gallery-item {
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--sky-blue) 45%, transparent);
    border-radius: 4px;
    overflow: hidden;
  }
  .aero__gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* P5: the block cursor blink (on the trailing terminal prompt) is the only
     hero animation, gated behind full motion (the default for everyone). Under
     the calm version (data-motion='reduced') the cursor rests solid — the
     static transcript IS the visual, never blank. US-202 adds the full-motion-
     gated typewriter; the static transcript stays authoritative throughout. */
  :global(html[data-motion='full']) .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>

{/* US-1606 — the interactive hero console. Its three elements (.hero__console,
    .hero__log, .hero__input) are created at RUNTIME by hero-terminal.ts, so they
    carry NO data-astro-cid and a scoped rule could never match them (the US-036
    runtime-element boundary, same as .cm-* / .research__sandpack-*): their rules
    MUST be global. The echoed command / output LINES are cloneNode copies of the
    SSR .hero__cmd/.hero__out nodes, so they inherit the cid and the scoped
    typography above applies to them unchanged. */}
<style is:global>
  /* The console is absolutely positioned inside .hero__io, so it is out of flow
     and can never grow the terminal window (zero CLS, AC4). Column layout: the
     log takes the remaining height and scrolls internally; the input line is
     pinned at the bottom, exactly where the SSR trailing prompt sat. */
  .hero__console {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  /* The Escape target (tabindex=-1, programmatic focus only — no visible ring,
     the same contract as main#main-content). */
  .hero__console:focus {
    outline: none;
  }
  /* flex: 0 1 auto — grow NEVER, shrink when needed. The log is exactly as tall
     as its content until the content outgrows the window, at which point it
     shrinks to the space available and scrolls. So the prompt always sits
     immediately under the last line (the handover from the rested animation is
     seamless, and `clear` puts the prompt back at the TOP of the screen the way
     a real one does) instead of being pinned to the bottom of an empty box. */
  .hero__log {
    flex: 0 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--mx-green-far) transparent;
  }
  /* The live prompt line. It is a clone of an SSR .hero__cmd, so it arrives with
     the hanging indent meant for wrapped echo lines — reset that and lay the
     prompt + input out as a single baseline row instead. The margin-bottom is
     dropped so the input line occupies exactly the trailing prompt's box. */
  .hero__console .hero__inputline {
    display: flex;
    align-items: baseline;
    gap: 0.5ch;
    flex: 0 0 auto;
    margin-bottom: 0;
    padding-left: 0;
    text-indent: 0;
  }
  /* The prompt's resting block cursor gives way to the real text caret, which
     lands in the same spot (the flex gap collapses with it). */
  .hero__console:focus-within .hero__inputline .cursor {
    display: none;
  }
  /* A bare shell input: no chrome of its own, inheriting the command line's
     font + green ramp so typed text is indistinguishable from the transcript's
     commands (P6/P7 — it reads --mx-green over the ~90%-void panel, exactly like
     .hero__cmd). */
  .hero__console .hero__input {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    caret-color: var(--mx-green-hi);
  }
  /* US-1701 — NO rectangle around the input while it is active. A text input
     matches :focus-visible on ANY focus (a click included, per spec), so the
     theme.css catch-all ring drew a box around the prompt row the moment the
     terminal was clicked and the window stopped reading as one screen. Both
     states are killed HERE (0,3,0 beats the 0,1,0 catch-all, which stays
     untouched for every other control — US-046) and nothing substitutes for it
     at the input level: no border, no box-shadow, no background flip. The
     replacement cue is window-level, below. The caret is the in-place typing
     indicator, and the console keeps its own focus cues (the resting block
     cursor gives way to the caret). */
  .hero__console .hero__input:focus,
  .hero__console .hero__input:focus-visible {
    outline: none;
    border: 0;
    box-shadow: none;
  }
  /* The console-LEVEL focus cue (WCAG 2.4.7 stays satisfied without a box round
     the input): the WHOLE terminal window lights up — hairline and title-bar
     seam step --mx-green-far → --mx-green-dim, the title bar's void face lifts
     and its label brightens, plus a soft green halo. `:has()` is what lets the
     runtime console reach its SSR ancestors; the rule lives in this global block
     because .hero__console carries no data-astro-cid, so a scoped rule (whose
     :has() argument would be cid-qualified) could never match it — the US-036
     runtime-element boundary applied to an ancestor selector. Palette tokens
     only (P7); the flip is INSTANT on both motion paths, only the easing below
     is gated on html[data-motion='full'] (P5). */
  .hero__term:has(.hero__console:focus-within) {
    border-color: var(--mx-green-dim);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--mx-green-dim) 40%, transparent),
      0 0 18px color-mix(in srgb, var(--mx-green) 16%, transparent);
  }
  .hero__term:has(.hero__console:focus-within) .hero__titlebar {
    background: color-mix(in srgb, var(--mx-void) 45%, transparent);
    border-bottom-color: var(--mx-green-dim);
  }
  .hero__term:has(.hero__console:focus-within) .hero__title {
    color: var(--mx-green);
  }
  html[data-motion='full'] .hero__term,
  html[data-motion='full'] .hero__titlebar,
  html[data-motion='full'] .hero__title {
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      background-color 200ms ease,
      color 200ms ease;
  }
</style>

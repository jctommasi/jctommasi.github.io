---
/**
 * PageBody (US-004, US-014) — the locale-driven page content, shared by both
 * routes so the cv read + locale handling live in one place (US-000b: content
 * is never hardcoded in components — it comes from the cv / site-strings
 * collections).
 *
 * US-014 turned this into the full single-page skeleton; US-1401 (owner reorder
 * 2026-08-02) re-cut it to 11 landmarks, and the owner reorder of 2026-08-20 set
 * the CURRENT canonical order — hero → about → skills → competencies →
 * experience → articles → research → aeronautics → interests → music → contact.
 * Work + Education stay retired render-side since US-1401 (cv.json untouched;
 * sections.work / sections.education / nav.work stay frozen-unused in
 * site-strings, the switcher precedent), and RESEARCH is gated off behind
 * SHOW_RESEARCH (see its block) — it renders LAST of the matrix register, right
 * after #articles, whenever the flag comes back on. So the page currently ships
 * 10 landmarks. Each keeps its language-agnostic id and an h2 from
 * site-strings.sections. The hero ships NO <h1> (US-201); every other section is
 * an `<h2>`.
 *
 * `<main id="main-content">` is the skip-link target (BaseLayout): focusable
 * via tabindex=-1 so "Skip to content" lands here, past the nav + hero canvas.
 */
import type { Locale } from '../i18n';
import { pick, loadStrings, localizedPath } from '../i18n';
import { getEntry } from 'astro:content';
import { resolveTodo } from '../data/todo';
// US-1604: THE shared `{yearsOffensive}` filler — every cv.json prose field
// carrying the token renders through fillYears() so the corporate
// offensive-security tenure (computed from February 2020 at build time) can
// never drift between sections.
import { fillYears } from '../data/years';
// 2026-08-08 Competencies redesign ("04 / SKILL CONSTELLATION"): the section is
// now a technical constellation of six capability nodes wired by meaningful
// connections. The node/relation/layout MODEL + the data-driven :has() highlight
// CSS live in the data module (generated from data, not six duplicated blocks);
// each node's full description is the REAL bilingual cv.json pillar/purpleTeam
// field (resolved via pick() below), so it adds zero new P8 strings and nothing
// is fabricated (the real-vs-derived split lives in the module header).
import {
  COMPETENCY_NODES,
  COMPETENCY_GRID,
  COMPETENCY_INITIAL_FOCUS,
  competencyEdges,
  relationsForNode,
  buildConstellationCss,
} from '../data/competencies';
import Section from './Section.astro';
import Icon from './Icon.astro';
// 2026-08-09 Contact redesign ("05 — FREQUENCY BANDS"): the section renders
// three stacked band links built by the dedicated data module — label + href
// verbatim from cv.json contact.social, the visible handle DERIVED from each
// URL's own path (never authored, P3). See the const below for the full note.
import { buildContactLinks } from '../data/contact-links';
// 2026-08-08 Research pipeline redesign ("07 / RESEARCH PIPELINE" lab console):
// the Research section is now an offensive-security pipeline (one row per
// investigation, five shared stages). Model + demo roadmap + helpers live in
// the data module (data-driven, not duplicated markup; real-vs-demo split + the
// P3 note live there). The rich per-chapter content (practice widgets, audio,
// transcript) now lives ONLY on the reader pages (ResearchArticle →
// ResearchPractice); the home section is the pipeline INDEX, and published rows
// link out to those reader pages.
import {
  RESEARCH_STAGES,
  STAGE_COUNT,
  STATUS_META,
  stageIndex,
  progressText,
  buildPipeline,
  SHOW_DEMO_PIPELINE,
  SHOW_RESEARCH,
} from '../data/research-pipeline';
// 2026-08-08 About redesign ("02 — Split Dossier"): the section is an
// asymmetric dossier — a compact FACT INDEX beside the PROFILE SUMMARY
// narrative + ORIGIN case-file block. The fact-row model and its
// real-vs-derived split live in the data module (rows generate from data; the
// tenure figures flow from years.ts / cv.json, never re-authored digits).
import { buildAboutFacts } from '../data/about-dossier';
// 2026-08-09 Music redesign ("01 — Cover Flow"): the Music section renders one
// Cover-Flow album selector PER titled COLLECTION — the owner's real curation
// (two lists today, more to come; adding one is a data-module edit only), each
// album individually linked to its real Tidal ALBUM page (the US-1609 playlist
// embeds are retired). Model, the album-URL guard, the dormant demo gate + the
// placeholder cover art live in the data module (P3 notes in its header).
import { buildMusicCollections, COVER_PLACEHOLDER_ART } from '../data/music-albums';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const cvEntry = await getEntry('cv', 'cv');
if (!cvEntry) throw new Error('cv content collection entry missing');
// US-201: the hero no longer renders the cv `name` (nor cv.title / profile.headline)
// — it is a name-free terminal window. SeoHead.astro still consumes name/title/
// headline for <title>, JSON-LD and OG, so cv.json is untouched.
// US-016 about prose (3 body paragraphs + origin story), all bilingual {es,en}
// fields read via pick(locale, …) (US-003).
const { body: profileBody, origin: profileOrigin, yearsExperience } = cvEntry.data.profile;
// Split Dossier FACT INDEX rows (2026-08-08): the backend / AI spans pass in
// from the structured cv.json fields (the module composes value from the REAL
// number, P3); the offensive tenure rides the {yearsOffensive} template and is
// filled at render through the shared fillYears() (US-1604 — one source, so
// the index can never disagree with the narrative beside it).
const aboutFacts = buildAboutFacts({
  yearsBackend: yearsExperience.backend,
  yearsAiAutomation: yearsExperience.aiAutomation,
});
// US-017 competencies: the 30-second summary, the 5 pillars, and the purple-team
// posture. All bilingual {es,en} via pick(). 2026-08-08 redesign: the pillars +
// purpleTeam ARE the six constellation nodes' descriptions — restructured, not
// rewritten (P3), so cv.json is untouched and every rendered description is the
// real bilingual field.
const { summary: compSummary, pillars: compPillars, purpleTeam } = cvEntry.data.competencies;
// Resolve each node's FULL DESCRIPTION from the cv.json field its `source` points
// at (pillar[i] or purpleTeam), and its tagline for the active locale. Title +
// concepts stay language-agnostic (OD-3); descriptions + taglines + relation
// labels are fully bilingual, so ES readers get Spanish for all prose.
const compNodes = COMPETENCY_NODES.map((node) => ({
  ...node,
  grid: COMPETENCY_GRID[node.id],
  tagline: pick(locale, node.tagline),
  description:
    node.source.kind === 'pillar'
      ? pick(locale, compPillars[node.source.index])
      : pick(locale, purpleTeam),
  // The node's connections, with the OTHER capability's title + the picked,
  // localized relation label — the accessible text that explains each link (so
  // the meaning never lives in the decorative lines alone, and mobile shows it).
  relations: relationsForNode(node.id).map((rel) => ({
    label: pick(locale, rel.label),
    otherTitle: COMPETENCY_NODES.find((n) => n.id === rel.otherId)?.title ?? rel.otherId,
  })),
}));
// Undirected edges for the decorative SVG. Since the 2026-08-09 "Ruta Activa"
// pass the endpoints are MEASURED from the real cards at runtime
// (src/components/competencies-map.ts — the grid cards have content-driven
// heights, so baked endpoints can no longer exist); the server renders the
// edge GROUPS (identity + accent + route) and the module writes only geometry.
const compEdges = competencyEdges();
// The data-driven :has() highlight/dim state machine (prefixed .cxn, injected
// once via <style is:global> — cannot leak to other sections).
const compConstellationCss = buildConstellationCss();
// US-018 skills: the 9 categories. Each category label is bilingual {es,en}
// (via pick); its items stay language-agnostic plain strings (US-003 froze
// skills[].items as identifiers/tool names).
const { skills } = cvEntry.data;
// 2026-08-09 CHANNEL STACK + DIAGNOSTIC MODE redesign (SUPERSEDES the
// 2026-08-08 Skill Tree presentation FOR THIS SECTION — same data, same nine
// <h3> census, new architecture; the tree's own notes live in git history):
// the section is a signal board — a left DIAGNOSTIC CONSOLE (STATUS / FOCUS /
// the arrow-key legend) beside the nine categories as channel MODULES whose
// headers ride horizontal channel lines into a right vertical bus. cv.json is
// UNTOUCHED (P3) and the redesign adds ZERO P8 strings: the console labels +
// the ACTIVE value are the US-003 shell-literal class (the pipeline stage /
// exp CHAPTERS precedent — a diagnostic console reads the same in both
// locales), while the FOCUS readout VALUE is content (the focused category
// title, bilingual via pick — ES reads the Spanish category).
//   THE ONE INTERACTIVE SURFACE: a roving-tabindex module grid wired by
//   skills-console.ts (eager; progressive enhancement — SSR ships NO tabindex,
//   so no-JS is a plain readable matrix with zero dead controls; the module
//   grants exactly one tabindex=0 stop, arrow-key navigation against the
//   EFFECTIVE column count, click/tap selection and the FOCUS mirror, then
//   stamps data-skills-ready). Section tab stops: 0 → 1.
//   Tool-token emphasis (US-1607) SURVIVES: each item splits on its FIRST
//   ' — ' separator, the lead segment (the tool/language token) rendering
//   emphasized and the remainder dimmer INLINE. `rest` KEEPS the separator,
//   so lead + rest === the original item character-for-character — the item's
//   textContent stays byte-equal to cv.json (and the alien-decode pair
//   pattern still restores to SSR-identical text). Items with no separator
//   ('NoSQL solutions', 'ARM architectures') return null and render whole; no
//   NEW punctuation-splitting rules were invented (P3).
const SKILL_ITEM_SEP = ' — ';
const splitSkillItem = (item: string): { lead: string; rest: string } | null => {
  const at = item.indexOf(SKILL_ITEM_SEP);
  return at === -1 ? null : { lead: item.slice(0, at), rest: item.slice(at) };
};
// Experience — "08 — Chapter Path" (2026-08-08 owner redesign; supersedes the
// US-020 flat timeline + US-705 collapse cards FOR THIS SECTION). The four
// roles from cv.json presented as navigable career CHAPTERS (master–detail;
// markup + progressive-enhancement notes at the section below). US-1401
// retired the Work section render-side — cv.json is untouched, so the
// experience data still carries every highlight, and ALL of them render in
// the detail panels. Derivations, never authored literals (P3):
//   — slug: a stable DOM id from the org name (US-020 records the orgs as
//     distinct/non-repeating; feeds the aria-controls/aria-labelledby pairs);
//   — number: the ARRAY POSITION in the displayed reverse-chronological
//     order (01 = the present), zero-padded like the pipeline LAB ids —
//     derived, so a fifth entry renumbers the whole path automatically;
//   — current: endYear === 'Present' — the TYPED schema literal
//     (content.config.ts yearOrPresent), NEVER a comparison against the
//     translated/display prose (the period string stays display-only).
// The CHAPTERS (sr-only) / NN OF NN / PERIOD / ACTIVE / COMPLETED /
// CAPABILITIES / HIGHLIGHTS / PREV / NEXT console chrome is language-agnostic
// technical labelling (the US-003 shell-literal class, the research-pipeline
// stage/status precedent) ⇒ ZERO new P8 strings.
const { experience } = cvEntry.data;
const expChapters = experience.map((exp, i) => ({
  ...exp,
  slug: exp.org
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, ''),
  number: String(i + 1).padStart(2, '0'),
  current: exp.endYear === 'Present',
}));
const expChapterTotal = String(expChapters.length).padStart(2, '0');
// US-1710 (owner ask 2026-08-08, "simulando los colores por default utilizados
// en la severidad de las vulnerabilidades, deben ser colores tono pastel en
// crossfade"): the timeline spine tells the escalation story — pastel
// white-grey at the OLDEST entry (bottom) blending up through green, blue,
// orange and red into pastel violet at the NEWEST (top).
//
// THE DISTRIBUTION DERIVES FROM ARRAY POSITION, never from a hard-coded
// per-entry colour: node i sits at the global ramp position i/(N-1) and the
// segment below it covers [i/(N-1), (i+1)/(N-1)], so ADDING OR REMOVING AN
// EXPERIENCE ENTRY REDISTRIBUTES THE WHOLE RAMP automatically (the six stops
// stay evenly spread over however many entries there are). The last entry
// draws no spine (its ::after is hidden), so the assembled spine runs node 0 →
// node N-1 and every adjacent pair of segments MEETS on the exact same colour.
//
// P7 AMENDMENT (US-1710): the --sev-* pastel ramp lives in theme.css and is
// legal ONLY here — the experience spine + node dots. No text ever sits on it
// (it is a 2px decorative rule and a dot border), so it colours no prose.
// Only the STOP POSITIONS are computed here; the colours stay token
// references, and an interpolated boundary is a color-mix() of two tokens —
// no hex literal reaches this file.
const SEVERITY_RAMP = [
  '--sev-violet',
  '--sev-red',
  '--sev-orange',
  '--sev-blue',
  '--sev-green',
  '--sev-grey',
] as const;
/** The ramp colour at global position p (0 = top/newest, 1 = bottom/oldest). */
const severityAt = (p: number): string => {
  const k = Math.min(Math.max(p, 0), 1) * (SEVERITY_RAMP.length - 1);
  const i = Math.min(Math.floor(k), SEVERITY_RAMP.length - 2);
  const frac = k - i;
  if (frac <= 0.0005) return `var(${SEVERITY_RAMP[i]})`;
  if (frac >= 0.9995) return `var(${SEVERITY_RAMP[i + 1]})`;
  return `color-mix(in oklab, var(${SEVERITY_RAMP[i + 1]}) ${(frac * 100).toFixed(2)}%, var(${SEVERITY_RAMP[i]}))`;
};
/** The gradient slice the entry-i segment carries (node i → node i+1). */
const severitySegment = (i: number, count: number): string => {
  const span = Math.max(count - 1, 1);
  const from = i / span;
  const to = (i + 1) / span;
  const stops = [`${severityAt(from)} 0%`];
  for (let s = 1; s < SEVERITY_RAMP.length - 1; s += 1) {
    const p = s / (SEVERITY_RAMP.length - 1);
    if (p > from && p < to) {
      stops.push(
        `var(${SEVERITY_RAMP[s]}) ${(((p - from) / (to - from)) * 100).toFixed(2)}%`,
      );
    }
  }
  stops.push(`${severityAt(to)} 100%`);
  return `linear-gradient(to bottom, ${stops.join(', ')})`;
};
// US-022 → US-1704 articles: the 2 published write-ups from cv.json.articles.
// The two real permalinks landed in US-1704 (verified against the live pages),
// so resolveTodo() now returns them and the href IS the precise article — the
// zero-code-change upgrade US-022 designed for (the `?? article.url` author-root
// fallback stays, for a future article added before its URL is known; the
// {{TODO}} literal is only ever read through resolveTodo, never rendered as
// text, so gate:todo stays green either way). title / publication / url /
// exactPermalink / date are language-agnostic plain strings (US-003 froze the
// first four; a calendar day is the same class), so no pick() here — except
// the 2026-08-08 restyle's OPTIONAL bilingual `description` dek (absent in
// seed data, P3: no invented summaries; renders via pick() the moment the
// owner writes one).
const { articles } = cvEntry.data;
// US-1704: the publication date is ONE ISO value in the data, formatted per
// locale at BUILD time — one source, zero new P8 strings, zero client JS. The
// BCP-47 tags are language-agnostic identifiers (the SeoHead en_US/es_ES map
// precedent), not translatable content. `timeZone: 'UTC'` is load-bearing:
// `new Date('2022-09-24')` is UTC midnight, so formatting in any timezone west
// of UTC (this build host is -03) would render the PREVIOUS day.
const ARTICLE_DATE_LOCALES: Record<Locale, string> = {
  en: 'en-US',
  es: 'es-ES',
};
const articleDateFormat = new Intl.DateTimeFormat(ARTICLE_DATE_LOCALES[locale], {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const formatArticleDate = (iso: string) =>
  articleDateFormat.format(new Date(`${iso}T00:00:00Z`));
// US-023 interests: the cv.json.interests — since US-1603 the 5 Gym, E-Sports,
// Meditation, Reading, Guitar (the Aeronautics chip was dropped: its own section
// sits right above). Each label is bilingual {es,en} (via pick); each carries a
// language-agnostic `icon` name (dumbbell / gamepad / meditation / book /
// guitar) rendered as a
// decorative inline-SVG cue (Icon.astro, aria-hidden — the label carries the
// meaning). An UNORDERED set (no ranking), so a <ul> of band stations ("03 —
// Banda Compacta" since 2026-08-09; the layout is pure CSS — no per-item
// inline vars, so the old Echo Trails meteorVars(i) helper left with the
// meteors). All content is data-sourced, so this adds ZERO new P8 strings
// (like Skills, US-018).
const { interests } = cvEntry.data;
// Contact — FREQUENCY BANDS (2026-08-09; supersedes the US-024/US-709
// icon-only row + the US-1610/US-1715 marquee). buildContactLinks() DERIVES
// the three routes (LinkedIn → GitHub → Medium / Blog, the mandated order in
// the module's channel spec) from cv.json contact.social: label + href
// VERBATIM, the visible handle parsed from the URL's own path (never
// authored, P3). Labels/URLs/handles are language-agnostic identifiers
// (US-003) ⇒ ZERO new P8 strings. Email + Instagram are deliberately NOT
// read here (the P1-by-omission idiom) — cv.json keeps the full record and
// SeoHead's Person JSON-LD (sameAs = the 4 social URLs + the mailto email)
// still derives from it: head metadata is a different surface from the
// Contact section, and touching it was explicitly out of this redesign's
// scope. The redundant blogUrl is still the same URL as the "Medium / Blog"
// social, so it is still not rendered twice.
const contactLinks = buildContactLinks(cvEntry.data.contact.social);
// US-025 research shell + US-031 chapter list: the section gets a brief bilingual
// lead-in followed by the published chapters themselves. US-1605 (owner call
// 2026-08-07) unpublished every chapter but 01, so the lead-in is now COUNT-FREE
// prose in both locales — no `{count}` placeholder, no plural claim that would
// go stale (or lie) as the published set changes; the list length is the honest
// count the reader sees.
const researchEntry = await getEntry('research-chapters', 'research-chapters');
if (!researchEntry) throw new Error('research-chapters content collection entry missing');
// US-031: render the chapters in CANONICAL ORDER. Sort by the explicit `order`
// field rather than trusting file order, so the list always reads as the
// intended sequence (the schema guarantees `order` is unique; spread first so we
// never mutate the validated collection array). The data is EXPLICITLY ordered
// (an `order` field exists precisely to define the sequence), so the list is an
// <ol> — the set-vs-sequence rule (US-020/US-021: a meaningful order ⇒ <ol>; cf.
// the Experience chronology, vs Education's unordered <ul> set). Each chapter's
// title / summary are bilingual {es,en} via pick(); tags are language-agnostic
// plain strings (like skills items / exp tags) ⇒ no pick(), ZERO new P8 strings.
// US-032 reads audioUrl through resolveTodo() (the {{TODO}} placeholder → null,
// rendered as an honest disabled "coming soon" control — see the audio player
// block below). US-033 reads the `transcript` boolean (the affordance gate) +
// the OPTIONAL `transcriptText` drop-in slot (absent now → the region
// shows "coming soon"; read via resolveTodo so a stray {{TODO}} also normalizes
// to pending). practiceType belongs to a later story (US-034+ practice widgets)
// and is still NOT read here (P1 by omission), so no {{TODO}} literal reaches
// the DOM — gate:todo stays green.
const researchChapters = [...researchEntry.data.chapters].sort((a, b) => a.order - b.order);
// 2026-08-08 pipeline redesign: build the lab pipeline rows — the real PUBLISHED
// chapters (title picked for the locale; each linking to its reader page) plus
// the flagged demo roadmap. The real-vs-demo split (P3) lives in the data
// module; a build warning names the demo rows so they are never mistaken for
// real research when shipping.
const researchPipeline = buildPipeline(
  researchChapters.map((ch) => ({
    id: ch.id,
    order: ch.order,
    title: pick(locale, ch.title),
    tags: ch.tags,
  })),
  (id) => localizedPath(`/research/${id}/`, locale),
);
const demoPipelineCount = researchPipeline.filter((item) => item.isDemo).length;
// Gated on SHOW_RESEARCH too: with the section hidden these rows reach no page,
// and a build warning about markup nobody renders is just noise.
if (SHOW_RESEARCH && SHOW_DEMO_PIPELINE && demoPipelineCount > 0) {
  console.warn(
    `[research-pipeline] Rendering ${demoPipelineCount} DEMO roadmap row(s) — placeholder research, not real (P3). ` +
      'Set SHOW_DEMO_PIPELINE=false in src/data/research-pipeline.ts to ship the real published research alone.',
  );
}
// US-025 hobby intros: the bilingual intro prose for the aeronautics and music
// sections from hobbies.json (read via pick). Every concrete specific (aircraft,
// ratings, hours, routes, gallery, instruments, artists, links) is an intentional
// {{TODO}} placeholder, so it is OMITTED here per P1 — the full Sky treatment +
// credential mark arrive in US-040/US-041, the Note-rain in US-042. The schema's
// discriminated union guarantees exactly one of each type, but TS can't infer
// that from `.find`, so we guard with an explicit throw (the getEntry pattern).
const hobbiesEntry = await getEntry('hobbies', 'hobbies');
if (!hobbiesEntry) throw new Error('hobbies content collection entry missing');
const aeronautics = hobbiesEntry.data.hobbies.find((h) => h.type === 'aeronautics');
const music = hobbiesEntry.data.hobbies.find((h) => h.type === 'music');
if (!aeronautics || !music) {
  throw new Error('hobbies: one aeronautics and one music entry are required');
}
// US-041 gallery drop-in path: each {src,alt} is a todoCapable field today, so
// resolveTodo() normalizes the {{TODO}} placeholders to null and the predicate
// drops the entry — placeholder entries render NOTHING (AC4), and no {{TODO}}
// literal can reach the DOM (P1; gate:todo stays green). When real images land,
// a {src,alt} pair survives the filter and renders an <img> with its meaningful
// alt straight from the data (P4) — zero code change.
const aeroGallery = aeronautics.gallery
  .map((img) => ({ src: resolveTodo(img.src), alt: resolveTodo(img.alt) }))
  .filter((img): img is { src: string; alt: string } => img.src !== null && img.alt !== null);
// US-042 music gallery drop-in: the SAME resolveTodo-filter rule as aeronautics
// (US-041, P4) — placeholder {{TODO}} entries normalize to null and are dropped
// (render nothing, P1; gate:todo stays green), a real {src,alt} pair survives and
// renders an <img> with its meaningful alt with zero code change. The other music
// specifics (instruments, artists, links) are wholly-placeholder sets, so they
// stay OMITTED per P1 (US-025) — nothing reaches the DOM.
const musicGallery = music.gallery
  .map((img) => ({ src: resolveTodo(img.src), alt: resolveTodo(img.alt) }))
  .filter((img): img is { src: string; alt: string } => img.src !== null && img.alt !== null);
// 2026-08-09 Music "01 — Cover Flow" redesign (SUPERSEDES the US-1609 playlist
// embeds): the section renders the owner's REAL album collections from
// src/data/music-albums.ts — one titled Cover-Flow row per collection (49
// albums across 2 shelves at this pass; a future collection is a data edit
// only). The Tidal ALBUM-URL guard (a playlist URL can never ship as an album
// link), the dormant demo gate and the P3 notes all live in the module header.
// The four playlist share URLs stay UNTOUCHED in hobbies.json (data intact,
// render-side retired — the US-1401 Work/Education precedent;
// `music.tidalPlaylists` and the `playlistTitle`/`playlistPending` strings
// freeze unused, the switcher P8 rule).
const musicCollections = buildMusicCollections();
const demoAlbumCount = musicCollections.reduce(
  (n, c) => n + c.albums.filter((a) => a.isDemo).length,
  0,
);
if (demoAlbumCount > 0) {
  console.warn(
    `[music-albums] Rendering ${demoAlbumCount} DEMO album placeholder(s) — a preview, not the ` +
      "owner's real collection (P3). Fill MUSIC_ALBUMS (or set SHOW_DEMO_ALBUMS=false) in " +
      'src/data/music-albums.ts to ship real albums.',
  );
}
// SSR selection state for the Cover Flow: the first album is active. data-pos
// is the signed offset from the active index ('0'/'±1'/'±2'/'±3', 'out' beyond
// the render window) — cover-flow.ts rewrites it on navigation, CSS owns the
// geometry (positions derive from the offset, never per-album literals).
const cfPos = (i: number): string => (Math.abs(i) > 3 ? 'out' : String(i));
const cfPad = (n: number): string => String(n).padStart(2, '0');

const strings = await loadStrings(locale);
const sections = strings.sections;
// US-025 research lead-in (P8 prose, ES/EN). US-1605 retired the `{count}`
// interpolation with the plural phrasing that needed it — the string renders
// verbatim now, so there is nothing to fill and nothing that can go stale.
const researchLead = strings.research.lead;
// Cover-as-link correction (2026-08-09): the active cover IS the album link —
// its full accessible name comes from the `music.openAlbum` template
// ({title}/{artist} placeholders). Replacer FUNCTIONS, not strings: album
// titles are arbitrary text and String.replace treats `$` in a string
// replacement specially.
const openAlbumLabel = (album: { title: string; artist: string }): string =>
  strings.music.openAlbum
    .replace('{title}', () => album.title)
    .replace('{artist}', () => album.artist);
---

<main id="main-content" tabindex="-1">
  {/*
    1. hero — a Linux terminal WINDOW (US-201). NO <h1>/name: the page ships 0
    h1 (owner's decision; the name lives only in <title>/JSON-LD/OG via SeoHead).
    The window is a .hero__titlebar (the drag handle, US-203) carrying a
